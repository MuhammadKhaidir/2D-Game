+    private static final int ATTACK_COOLDOWN   = 70;
+    private static final int HURT_TICKS        = 16;
+    private static final int HURT_IMMUNITY     = 56;     // jeda sesudah terhuyung di mana pukulan gak bikin dia terhuyung lagi
