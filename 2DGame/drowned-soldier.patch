+    private static final int SPRITE_OFF_Y = -38;
+
+    // ═══════════ STAT (gampang di-tune) ═══════════
+    public static final int    MAX_LIFE        = 1100;
+    public static final int    ATTACK_DAMAGE   = 40;
+    public static final double MOVE_SPEED      = 1.4;    // px / frame saat ngejar
