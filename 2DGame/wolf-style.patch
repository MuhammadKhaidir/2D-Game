+def pix(name):
+    return {(x, y): ch for y, row in enumerate(REF[name]) for x, ch in enumerate(row) if ch != '.'}
+
+
+def dims(p):
+    return max(x for x, _ in p) + 1, max(y for _, y in p) + 1
+
+
+def shift(p, dx, dy):
+    return {(x + dx, y + dy): c for (x, y), c in p.items()}
+
+
+def merge(*ps):
+    out = {}
+    for q in ps:
+        out.update(q)
+    return out
+
+
+def split(p, pred):
+    a = {k: v for k, v in p.items() if pred(*k)}
+    b = {k: v for k, v in p.items() if not pred(*k)}
+    return a, b
+
+
+def breath(p, cut, dy=1):
+    """Badan "ngempis": semua baris di atas `cut` turun `dy`, bagian bawah (kaki) tetap."""
+    up, low = split(p, lambda x, y: y < cut)
+    return merge(low, shift(up, 0, dy))
+
+
+def shear(p, anchor, last, amp):
+    """Ayun anggota badan dari pangkalnya (baris `anchor`) sampai ujung (baris `last`): geser makin jauh makin banyak."""
+    out = {}
+    for (x, y), c in p.items():
+        dx = int(round(amp * max(0, y - anchor) / float(last - anchor)))
+        out[(x + dx, y)] = c
+    return out
+
+
+def place(p, cx=None, ox=0, oy=0):
+    """Taruh sprite: tengah horizontal, kaki paling bawah di GROUND. Balikin (sprite, offset x, offset y)."""
+    w, h = dims(p)
+    return p, (NW - w) // 2 + ox, GROUND - (h - 1) + oy
+
