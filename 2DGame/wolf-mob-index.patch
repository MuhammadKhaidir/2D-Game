+    // Grid & detail menggambar ikon ke kotak persegi. Sprite yang lebar (serigala 62x34) dipotong ke bagian
+    // yang berisi piksel lalu ditaruh di tengah kanvas persegi, supaya tidak melar.
+    private static Image squareIcon(BufferedImage src) {
+        if (src == null) return null;
+        int minX = src.getWidth(), minY = src.getHeight(), maxX = -1, maxY = -1;
+        for (int y = 0; y < src.getHeight(); y++) {
+            for (int x = 0; x < src.getWidth(); x++) {
+                if ((src.getRGB(x, y) >>> 24) != 0) {
+                    minX = Math.min(minX, x);
+                    maxX = Math.max(maxX, x);
+                    minY = Math.min(minY, y);
+                    maxY = Math.max(maxY, y);
+                }
+            }
+        }
+        if (maxX < 0) return src; // gambar kosong
+        int w = maxX - minX + 1, h = maxY - minY + 1, side = Math.max(w, h);
+        BufferedImage out = new BufferedImage(side, side, BufferedImage.TYPE_INT_ARGB);
+        Graphics2D g = out.createGraphics();
+        g.drawImage(src.getSubimage(minX, minY, w, h), (side - w) / 2, (side - h) / 2, null);
+        g.dispose();
+        return out;
+    }
