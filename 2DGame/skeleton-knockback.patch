     }
+
+    /**
+     * Dorong skeleton menjauh dari penyerang (player / minion).
+     * Panggil SETELAH takeDamage(). Kalau hit-nya bikin skeleton mati, gak ngapa-ngapain
+     * (takeDamage gak masukin state HURT kalau life <= 0, jadi mayatnya gak ikut terpental).
+     */
+    public void knockbackFrom(Entity attacker) {
+        if (attacker == null || !alive || life <= 0 || skState == SkeletonState.DEATH) return;
+
+        int atkCX = attacker.x + attacker.solidArea.x + attacker.solidArea.width  / 2;
+        int atkCY = attacker.y + attacker.solidArea.y + attacker.solidArea.height / 2;
+        int myCX  = x + solidArea.x + solidArea.width  / 2;
+        int myCY  = y + solidArea.y + solidArea.height / 2;
+
+        double dx = myCX - atkCX;
+        double dy = myCY - atkCY;
+        double len = Math.hypot(dx, dy);
+
+        if (len < 1) {
+            // pusat numpuk persis -> dorong ke arah hadap penyerang
+            dx = 0; dy = 0;
+            String dir = attacker.direction == null ? "down" : attacker.direction;
+            switch (dir) {
+                case "up":    dy = -1; break;
+                case "left":  dx = -1; break;
+                case "right": dx =  1; break;
+                default:      dy =  1; break;
+            }
+            len = 1;
+        }
+
+        kbVelX = dx / len * KB_SPEED;
+        kbVelY = dy / len * KB_SPEED;
+        kbAccX = 0;
+        kbAccY = 0;
+    }
+
+    private void updateKnockback() {
+        if (kbVelX == 0 && kbVelY == 0) return;
+
+        kbAccX += kbVelX;
+        kbAccY += kbVelY;
+        int stepX = (int) kbAccX;
+        int stepY = (int) kbAccY;
+        kbAccX -= stepX;
+        kbAccY -= stepY;
+
+        // geser 1 piksel per langkah, sumbu X dan Y sendiri-sendiri
+        // (biar mentok di tembok gak nembus, dan tetap bisa nyeret di sepanjang tembok)
+        int signX = Integer.signum(stepX), signY = Integer.signum(stepY);
+        for (int i = 0; i < Math.abs(stepX); i++) {
+            if (knockbackBlocked(signX, 0)) { kbVelX = 0; kbAccX = 0; break; }
+            x += signX;
+        }
+        for (int i = 0; i < Math.abs(stepY); i++) {
+            if (knockbackBlocked(0, signY)) { kbVelY = 0; kbAccY = 0; break; }
+            y += signY;
+        }
+
+        kbVelX *= KB_FRICTION;
+        kbVelY *= KB_FRICTION;
+    }
+
+    private boolean knockbackBlocked(int dx, int dy) {
+        Rectangle next = new Rectangle(x + solidArea.x + dx, y + solidArea.y + dy, solidArea.width, solidArea.height);
+        if (gp.domainManager != null && gp.domainManager.checkCollision(next)) return true;
+
+        // jangan sampai skeleton terdorong masuk ke badan player
+        Rectangle cur = new Rectangle(x + solidArea.x, y + solidArea.y, solidArea.width, solidArea.height);
+        Rectangle pl  = new Rectangle(gp.player.x + gp.player.solidArea.x, gp.player.y + gp.player.solidArea.y,
+                                      gp.player.solidArea.width, gp.player.solidArea.height);
+        return next.intersects(pl) && !cur.intersects(pl);
+    }
 }
