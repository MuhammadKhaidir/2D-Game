diff --git a/2DGame/src/Entitas/PlayerBuffs.java b/2DGame/src/Entitas/PlayerBuffs.java
new file mode 100644
index 0000000..54e6e97
--- /dev/null
+++ b/2DGame/src/Entitas/PlayerBuffs.java
@@ -0,0 +1,152 @@
+package Entitas;
+
+/**
+ * Buff sementara buat player (dari boost potion).
+ *
+ * Kekuatan & durasi semua buff diatur di konstanta paling atas — ubah di situ kalau mau di-balance.
+ * Timer jalan per frame di player.update(), jadi otomatis ikut berhenti kalau game lagi
+ * di-pause (dialog, shop, dll). Minum potion yang sama pas buff-nya masih aktif = timer direset ke penuh
+ * (efeknya tidak menumpuk).
+ */
+public class PlayerBuffs {
+
+    // ===== KEKUATAN BUFF =====
+    public static final int    DURATION_SECONDS        = 120;  // 2 menit, sama buat semua boost potion
+    public static final double DAMAGE_MULTIPLIER       = 1.5;  // +50% damage
+    public static final double SPEED_MULTIPLIER        = 1.3;  // +30% kecepatan jalan (& lari)
+    public static final double ATTACK_SPEED_MULTIPLIER = 1.5;  // +50% kecepatan animasi serangan
+    public static final int    MAX_HP_BONUS            = 50;   // +50 max HP (HP sekarang ikut naik segitu)
+
+    public enum Buff {
+        DAMAGE("Damage Boost"),
+        SPEED("Speed Boost"),
+        ATTACK_SPEED("Attack Speed Boost"),
+        MAX_HP("Max HP Boost");
+
+        public final String label;
+
+        Buff(String label) {
+            this.label = label;
+        }
+
+        /** Teks efek singkat buat deskripsi item, mis. "+50% damage". Ikut berubah kalau konstanta di atas diubah. */
+        public String effectText() {
+            switch (this) {
+                case DAMAGE:       return "+" + percent(DAMAGE_MULTIPLIER) + "% damage";
+                case SPEED:        return "+" + percent(SPEED_MULTIPLIER) + "% move speed";
+                case ATTACK_SPEED: return "+" + percent(ATTACK_SPEED_MULTIPLIER) + "% attack speed";
+                default:           return "+" + MAX_HP_BONUS + " max HP";
+            }
+        }
+
+        private static long percent(double multiplier) {
+            return Math.round((multiplier - 1.0) * 100);
+        }
+    }
+
+    private final player owner;
+    private final int[] framesLeft = new int[Buff.values().length];
+
+    private int appliedMaxHp = 0;            // bonus max HP yang SAAT INI lagi nempel di owner.maxLife
+    private double attackTickBank = 0;       // penampung "tick bonus" animasi serangan (buat buff attack speed)
+
+    public PlayerBuffs(player owner) {
+        this.owner = owner;
+    }
+
+    // ===================================================================
+    // AKTIFKAN / UPDATE / HAPUS
+    // ===================================================================
+
+    public void activate(Buff buff, int frames) {
+        framesLeft[buff.ordinal()] = frames;
+
+        if (buff == Buff.MAX_HP && appliedMaxHp == 0) {
+            appliedMaxHp = MAX_HP_BONUS;
+            owner.maxLife += appliedMaxHp;
+            owner.life += appliedMaxHp;      // HP ikut naik, biar bonusnya kerasa langsung
+        }
+    }
+
+    /** Dipanggil player.update() tiap frame. */
+    public void update() {
+        for (Buff buff : Buff.values()) {
+            int i = buff.ordinal();
+            if (framesLeft[i] > 0 && --framesLeft[i] == 0) {
+                onExpire(buff);
+            }
+        }
+    }
+
+    /** Matikan semua buff sekarang (dipanggil pas mati / load save). */
+    public void clear() {
+        for (Buff buff : Buff.values()) {
+            if (framesLeft[buff.ordinal()] > 0) {
+                framesLeft[buff.ordinal()] = 0;
+                onExpire(buff);
+            }
+        }
+        removeMaxHpBonus();
+        attackTickBank = 0;
+    }
+
+    private void onExpire(Buff buff) {
+        if (buff == Buff.MAX_HP) removeMaxHpBonus();
+        if (buff == Buff.ATTACK_SPEED) attackTickBank = 0;
+    }
+
+    private void removeMaxHpBonus() {
+        if (appliedMaxHp == 0) return;
+        owner.maxLife -= appliedMaxHp;
+        appliedMaxHp = 0;
+        owner.life = Math.min(owner.life, owner.maxLife);
+    }
+
+    // ===================================================================
+    // STATUS
+    // ===================================================================
+
+    public boolean isActive(Buff buff) {
+        return framesLeft[buff.ordinal()] > 0;
+    }
+
+    public int secondsLeft(Buff buff) {
+        return (int) Math.ceil(framesLeft[buff.ordinal()] / (double) owner.gp.FPS);
+    }
+
+    /** Bonus max HP yang lagi aktif (0 kalau tidak ada). Dipakai save & stat UI supaya buff tidak ikut "permanen". */
+    public int getMaxHpBonus() {
+        return appliedMaxHp;
+    }
+
+    /** "2:00", "0:45", dst. */
+    public static String formatTime(int seconds) {
+        return (seconds / 60) + ":" + String.format("%02d", seconds % 60);
+    }
+
+    // ===================================================================
+    // EFEK KE STAT PLAYER
+    // ===================================================================
+
+    public int scaleDamage(int damage) {
+        return isActive(Buff.DAMAGE) ? (int) Math.round(damage * DAMAGE_MULTIPLIER) : damage;
+    }
+
+    public double scaleSpeed(double speed) {
+        return isActive(Buff.SPEED) ? speed * SPEED_MULTIPLIER : speed;
+    }
+
+    /**
+     * Dipanggil tiap frame selama animasi serangan. True = frame ini animasinya dapat 1 tick ekstra
+     * (jadi serangan selesai lebih cepat). Pecahan multiplier dikumpulin, jadi 1.5x = tick ekstra tiap 2 frame.
+     */
+    public boolean consumeExtraAttackTick() {
+        if (!isActive(Buff.ATTACK_SPEED)) return false;
+        attackTickBank += ATTACK_SPEED_MULTIPLIER - 1.0;
+        if (attackTickBank >= 1.0) {
+            attackTickBank -= 1.0;
+            return true;
+        }
+        return false;
+    }
+}
diff --git a/2DGame/src/Entitas/PotionMerchant.java b/2DGame/src/Entitas/PotionMerchant.java
new file mode 100644
index 0000000..faf715a
--- /dev/null
+++ b/2DGame/src/Entitas/PotionMerchant.java
@@ -0,0 +1,193 @@
+package Entitas;
+
+import java.awt.Color;
+import java.awt.Font;
+import java.awt.FontMetrics;
+import java.awt.Graphics2D;
+import java.awt.Rectangle;
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.io.InputStream;
+import javax.imageio.ImageIO;
+
+import Main.GamePanel;
+
+/**
+ * NPC penjual potion (dulunya Weapon Dealer). Berdiri diam, animasi idle, dan kalau di-talk (E)
+ * muncul dialog; pilih "Show me your potions" buat buka toko (UI.PotionShopUI).
+ */
+public class PotionMerchant extends Entity {
+
+    public static final String DIALOG_ID = "potionmerchant";
+    private static final String DISPLAY_NAME = "Potion Merchant";
+    private static final String TALK_HINT    = "[E] Talk";
+
+    // ===== SPRITE =====
+    // 8 frame idle. Sprite-nya masih pakai gambar lama; kalau nanti punya sprite baru,
+    // cukup ganti prefix ini (mis. "/NPCs/PotionMerchantNPC00" untuk PotionMerchantNPC000..007.png).
+    private static final String SPRITE_PREFIX = "/NPCs/WeaponDealerNPC00";
+    private static final int FRAME_COUNT = 8;
+    private static final int FRAME_DELAY = 7;
+
+    // Ukuran gambar dalam satuan tileSize (2.5 = 2.5x tileSize). Bisa desimal.
+    private static final double SCALE = 2.5;
+
+    // Posisi spawn (kolom, baris tile)
+    private static final int SPAWN_COL = 10;
+    private static final int SPAWN_ROW = 26;
+
+    private final BufferedImage[] idleFrames = new BufferedImage[FRAME_COUNT];
+    private int frameIndex = 0;
+    private int frameTimer = 0;
+
+    public PotionMerchant(GamePanel gp) {
+        super(gp);
+
+        x = gp.tileSize * SPAWN_COL;
+        y = gp.tileSize * SPAWN_ROW;
+
+        direction = "down";
+        speed     = 0;
+        npcState  = NPCState.STAY;
+        name      = DISPLAY_NAME;
+
+        solidArea = new Rectangle(8, 16, 32, 32);
+        solidAreaDefaultX = solidArea.x;
+        solidAreaDefaultY = solidArea.y;
+
+        dialogId = DIALOG_ID;
+
+        loadFrames();
+    }
+
+    // ===================================================================
+    // DIALOG
+    // ===================================================================
+
+    /** Daftarin dialog merchant ke dialogMap. Dipanggil GamePanel.setupDialogs(). */
+    public static void registerDialog(GamePanel gp) {
+        DialogNode root = new DialogNode(
+            "Potions! Healing, strength, speed... whatever keeps you breathing. Take a look."
+        );
+        root.addOption("Show me your potions.", null, () -> gp.potionShop.open());
+        root.addOption("Nevermind.", null);
+
+        gp.dialogMap.put(DIALOG_ID, root);
+    }
+
+    public void initDialog() {
+        dialogRoot    = gp.dialogMap.get(dialogId);
+        currentDialog = dialogRoot;
+    }
+
+    // ===================================================================
+    // SPRITE
+    // ===================================================================
+
+    private void loadFrames() {
+        for (int i = 0; i < FRAME_COUNT; i++) {
+            String path = SPRITE_PREFIX + i + ".png";
+            try (InputStream is = getClass().getResourceAsStream(path)) {
+                idleFrames[i] = (is != null) ? ImageIO.read(is) : null;
+            } catch (IOException e) {
+                idleFrames[i] = null;
+            }
+            if (idleFrames[i] == null) {
+                System.err.println("[PotionMerchant] Gagal load: " + path);
+            }
+        }
+    }
+
+    /** Kotak gambar di layar. Kaki NPC tetap di titik (x, y); gambar "tumbuh" ke atas dan melebar ke kiri-kanan. */
+    private Rectangle spriteBounds() {
+        int w = (int) (gp.tileSize * SCALE);
+        int h = (int) (gp.tileSize * SCALE);
+
+        int screenX = x - gp.player.x + gp.player.screenX;
+        int screenY = y - gp.player.y + gp.player.screenY;
+
+        return new Rectangle(
+            screenX - (w - gp.tileSize) / 2,
+            screenY - (h - gp.tileSize),
+            w, h
+        );
+    }
+
+    // ===================================================================
+    // UPDATE & DRAW
+    // ===================================================================
+
+    @Override
+    public void setAction() {}
+
+    @Override
+    public void update() {
+        frameTimer++;
+        if (frameTimer >= FRAME_DELAY) {
+            frameIndex = (frameIndex + 1) % idleFrames.length;
+            frameTimer = 0;
+        }
+
+        if (talkCooldown > 0) talkCooldown--;
+    }
+
+    @Override
+    public void draw(Graphics2D g2) {
+        Rectangle b = spriteBounds();
+
+        // di luar layar → gak usah digambar
+        if (b.x + b.width < gp.viewMinX() || b.x > gp.viewMaxX() ||
+            b.y + b.height < gp.viewMinY() || b.y > gp.viewMaxY()) return;
+
+        drawShadow(g2);
+
+        BufferedImage frame = idleFrames[frameIndex];
+        if (frame != null) {
+            g2.drawImage(frame, b.x, b.y, b.width, b.height, null);
+        } else {
+            // fallback kalau sprite gak ketemu: kotak kuning
+            g2.setColor(new Color(255, 200, 50, 200));
+            g2.fillRect(b.x, b.y, b.width, b.height);
+            g2.setColor(Color.BLACK);
+            g2.drawRect(b.x, b.y, b.width, b.height);
+            g2.setFont(new Font("Dialog", Font.BOLD, 10));
+            g2.drawString("PM", b.x + 10, b.y + b.height / 2);
+        }
+    }
+
+    /** Nama di atas kepala + hint "[E] Talk" kalau player cukup dekat. */
+    @Override
+    public void drawOverhead(Graphics2D g2) {
+        Rectangle b = spriteBounds();
+        int centerX = b.x + b.width / 2;
+        int nameY = b.y - 6;
+
+        g2.setFont(new Font("Dialog", Font.BOLD, 12));
+        FontMetrics fm = g2.getFontMetrics();
+        g2.setColor(new Color(255, 220, 60));
+        g2.drawString(DISPLAY_NAME, centerX - fm.stringWidth(DISPLAY_NAME) / 2, nameY);
+
+        if (gp.player.getInteractArea().intersects(getInteractArea())) {
+            g2.setFont(new Font("Dialog", Font.PLAIN, 11));
+            fm = g2.getFontMetrics();
+            int tagW = fm.stringWidth(TALK_HINT);
+            int tagX = centerX - tagW / 2;
+            int tagY = nameY - 16;
+
+            g2.setColor(new Color(0, 0, 0, 160));
+            g2.fillRoundRect(tagX - 4, tagY - 12, tagW + 8, 16, 6, 6);
+            g2.setColor(Color.WHITE);
+            g2.drawString(TALK_HINT, tagX, tagY);
+        }
+    }
+
+    @Override
+    public Rectangle getInteractArea() {
+        return new Rectangle(
+            x - gp.tileSize,
+            y - gp.tileSize,
+            gp.tileSize * 3,
+            gp.tileSize * 3
+        );
+    }
+}
