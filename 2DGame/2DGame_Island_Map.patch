+	/**
+	 * Bentuk ulang area inti menjadi dua pulau yang dipisahkan laut.
+	 * Pulau hijau tetap di utara/timur; area es yang sudah ada menjadi pulau terpisah di selatan-barat.
+	 * Tile pantai memakai indeks yang sudah terdaftar di WorldGen.SHORE_BASE.
+	 */
+	private void applyIslandLayout(int cols, int rows) {
+		boolean[][] newSea = new boolean[cols][rows];
+
+		// Laut barat, kanal pemisah di utara pulau es, dan selat di sisi timurnya.
+		for (int c = 0; c < cols; c++) {
+			for (int r = 0; r < rows; r++) {
+				boolean sea = c < 5
+						|| (r >= 190 && r <= 203 && c <= 193)
+						|| (r >= 197 && r <= 320 && c >= 194 && c <= 202);
+				if (sea) {
+					mapTileNum[c][r] = 2;
+					newSea[c][r] = true;
+				}
+			}
+		}
+
+		// Bentuk bibir pantai setelah seluruh kanal air terisi, agar arah tile konsisten.
+		for (int c = 0; c < cols; c++) {
+			for (int r = 0; r < rows; r++) {
+				if (!newSea[c][r]) continue;
+				boolean n = gen.isLand(c, r - 1);
+				boolean e = gen.isLand(c + 1, r);
+				boolean s = gen.isLand(c, r + 1);
+				boolean w = gen.isLand(c - 1, r);
+				int count = (n ? 1 : 0) + (e ? 1 : 0) + (s ? 1 : 0) + (w ? 1 : 0);
+				int t = 2;
+
+				if (count == 0) {
+					if (gen.isLand(c + 1, r - 1)) t = 16;
+					else if (gen.isLand(c - 1, r - 1)) t = 20;
+					else if (gen.isLand(c - 1, r + 1)) t = 22;
+					else if (gen.isLand(c + 1, r + 1)) t = 23;
+					else if (((WorldGen.h2(c, r, 9) >>> 5) % 100) < 6) t = 1;
+				} else if (count == 1) {
+					t = n ? 18 : (s ? 17 : (w ? 21 : 14));
+				} else if (count == 2 && n && e) t = 15;
+				else if (count == 2 && n && w) t = 19;
+				else if (count == 2 && s && e) t = 57;
+				else if (count == 2 && s && w) t = 59;
+				else t = n ? 18 : (s ? 17 : (w ? 21 : 14));
+
+				// Gunakan shoreline salju jika sisi daratan yang berbatasan memang menerima overlay es.
+				boolean coldBank =
+						(n && gen.ice(c + 0.5f, r - 0.5f) > 0.5f)
+						|| (e && gen.ice(c + 1.5f, r + 0.5f) > 0.5f)
+						|| (s && gen.ice(c + 0.5f, r + 1.5f) > 0.5f)
+						|| (w && gen.ice(c - 0.5f, r + 0.5f) > 0.5f)
+						|| (gen.isLand(c + 1, r - 1) && gen.ice(c + 1.5f, r - 0.5f) > 0.5f)
+						|| (gen.isLand(c - 1, r - 1) && gen.ice(c - 0.5f, r - 0.5f) > 0.5f)
+						|| (gen.isLand(c + 1, r + 1) && gen.ice(c + 1.5f, r + 1.5f) > 0.5f)
+						|| (gen.isLand(c - 1, r + 1) && gen.ice(c - 0.5f, r + 1.5f) > 0.5f);
+				if (coldBank) {
+					for (int i = 0; i < WorldGen.SHORE_BASE.length; i++) {
+						if (WorldGen.SHORE_BASE[i] == t) {
+							t = WorldGen.SNOW_SHORE_FIRST + i;
+							break;
+						}
+					}
+				}
+				mapTileNum[c][r] = t;
+			}
+		}
+	}
