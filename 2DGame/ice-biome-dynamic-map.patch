diff --git a/2DGame/src/bahan/ChunkManager.java b/2DGame/src/bahan/ChunkManager.java
new file mode 100644
index 0000000..e2d6b6f
--- /dev/null
+++ b/2DGame/src/bahan/ChunkManager.java
@@ -0,0 +1,440 @@
+package bahan;
+
+import java.awt.AlphaComposite;
+import java.awt.Composite;
+import java.awt.Graphics2D;
+import java.awt.image.BufferedImage;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+
+import Item.Item;
+import Item.ItemManager;
+import Main.GamePanel;
+import Object.breakable;
+
+/**
+ * Peta dinamis: dunia dibagi jadi chunk {@link #CH} x {@link #CH} tile. Chunk di dekat player dimuat, chunk yang
+ * jauh dibuang, jadi jumlah objek / gambar yang aktif tidak ikut membesar walau dunianya luas.
+ *
+ * Isi sebuah chunk (semuanya murni fungsi dari koordinat, lihat {@link WorldGen}, jadi dibuang lalu dimuat lagi
+ * hasilnya sama):
+ *  - tile dasar area baru (di luar peta lama) -> ditulis ke mapTileNum selama chunk aktif
+ *  - kulit salju / es (gambar RGBA hasil {@link IceGround}), di-bake di thread terpisah supaya game tidak patah-patah
+ *  - pohon / batu / kristal yang bisa dihancurkan: dipinjam dari "kolam" slot di TileM.breakables, dan collision-nya
+ *    dipasang / dilepas ikut chunk
+ *  - hiasan tanpa collision (semak, cahaya kristal)
+ *
+ * Semua perubahan state game (mapTileNum, breakables, objCol) hanya terjadi di thread game; thread pembuat gambar
+ * cuma menghasilkan gambar.
+ */
+public final class ChunkManager {
+
+    public static final int CH = 32;
+    /** chunk yang jaraknya (tile, dari player) kurang dari ini dimuat */
+    public static final int LOAD_TILES = 40;
+    /** chunk yang jaraknya lebih dari ini dibuang (lebih besar dari LOAD supaya tidak bolak-balik muat-buang) */
+    public static final int UNLOAD_TILES = 64;
+    /** paling banyak chunk yang diaktifkan per frame (supaya tidak ada frame yang berat) */
+    private static final int MAX_ACTIVATE_PER_FRAME = 2;
+
+    private final GamePanel gp;
+    private final TileM tm;
+    private final WorldGen gen;
+    private final IceSprites spr;
+    private final int ts;
+    private final int ncx, ncy;
+    private final Chunk[] chunks;
+    private final List<Chunk> active = new ArrayList<>();         // hanya disentuh thread game
+    private volatile Chunk[] view = new Chunk[0];                  // salinan 'active' untuk thread gambar (tidak pernah diubah, hanya diganti)
+    private boolean viewDirty = false;
+    private final ExecutorService baker;
+    /** chunk yang jaraknya (tile) kurang dari ini dari player pasti dimuat + gambarnya siap SEBELUM frame berikutnya digambar (isi layar) */
+    private final int forceTiles;
+
+    // kolam slot breakables
+    private final int poolBase;
+    private final int[] freeSlots;
+    private int nFree;
+
+    // gambar & animasi pohon biasa (dipakai pohon hutan di area baru)
+    private final BufferedImage[] oakIdle, oakHit, oakDown, frostIdle, frostHit, frostDown;
+    private final BufferedImage rockImg, bushImg, snowBushImg;
+
+    /** statistik untuk tes / debug */
+    public int activations = 0, deactivations = 0, syncBakes = 0;
+
+    /** hiasan tanpa collision di satu chunk: tidak pernah diubah sesudah dibuat, jadi aman dibaca thread gambar */
+    private static final class Decor {
+        static final Decor EMPTY = new Decor(0);
+        final int n;
+        final int[] x, y, w, h;
+        final byte[] kind;
+        final BufferedImage[] img;
+        Decor(int n) {
+            this.n = n;
+            x = new int[n]; y = new int[n]; w = new int[n]; h = new int[n];
+            kind = new byte[n]; img = new BufferedImage[n];
+        }
+    }
+
+    /*
+     * Pembagian thread: update() (muat / buang / ubah mapTileNum / breakables / collision) hanya jalan di thread game.
+     * Thread gambar (EDT) cuma MEMBACA: daftar chunk lewat 'view', gambar lewat 'baked', hiasan lewat 'decor' --
+     * ketiganya diganti utuh (volatile), tidak pernah diubah di tempat.
+     */
+    private static final class Chunk {
+        final int cx, cy, col0, row0;
+        boolean active;                      // thread game saja
+        Future<IceGround.Result> future;     // thread game saja
+        volatile IceGround.Result baked;     // gambar salju/es + penanda tile tertutup; null = belum siap / tidak ada
+        boolean bakeDone;                    // thread game saja
+        int[] slots = new int[0];            // thread game saja
+        volatile Decor decor = Decor.EMPTY;
+
+        Chunk(int cx, int cy) {
+            this.cx = cx; this.cy = cy;
+            this.col0 = cx * CH; this.row0 = cy * CH;
+        }
+    }
+
+    public ChunkManager(GamePanel gp, TileM tm, WorldGen gen, IceSprites spr, int poolBase, int poolSize,
+                        BufferedImage[] oakIdle, BufferedImage[] oakHit, BufferedImage[] oakDown,
+                        BufferedImage[] frostIdle, BufferedImage[] frostHit, BufferedImage[] frostDown) {
+        this.gp = gp;
+        this.tm = tm;
+        this.gen = gen;
+        this.spr = spr;
+        this.ts = gp.tileSize;
+        this.ncx = (WorldGen.WORLD_COLS + CH - 1) / CH;
+        this.ncy = (WorldGen.WORLD_ROWS + CH - 1) / CH;
+        this.chunks = new Chunk[ncx * ncy];
+        for (int cy = 0; cy < ncy; cy++) for (int cx = 0; cx < ncx; cx++) chunks[cy * ncx + cx] = new Chunk(cx, cy);
+
+        this.poolBase = poolBase;
+        this.freeSlots = new int[poolSize];
+        for (int i = 0; i < poolSize; i++) freeSlots[i] = poolBase + poolSize - 1 - i;   // slot pertama dipakai duluan
+        this.nFree = poolSize;
+
+        this.oakIdle = oakIdle; this.oakHit = oakHit; this.oakDown = oakDown;
+        this.frostIdle = frostIdle; this.frostHit = frostHit; this.frostDown = frostDown;
+        this.rockImg = tm.tile[71] != null ? tm.tile[71].image : null;
+        this.bushImg = tm.tile[66] != null ? tm.tile[66].image : null;
+        this.snowBushImg = tm.tile[69] != null ? tm.tile[69].image : null;
+
+        // layar paling lebar = setengah lebar layar / zoom minimum; ditambah cadangan
+        double halfTiles = Math.max(gp.screenWidth, gp.screenHeight) / (2.0 * ts * GamePanel.ZOOM_MIN);
+        this.forceTiles = (int) Math.ceil(halfTiles) + 4;
+
+        this.baker = Executors.newSingleThreadExecutor(r -> {
+            Thread t = new Thread(r, "chunk-baker");
+            t.setDaemon(true);
+            t.setPriority(Thread.NORM_PRIORITY - 1);
+            return t;
+        });
+    }
+
+    public WorldGen gen() { return gen; }
+    public IceSprites sprites() { return spr; }
+    public int activeCount() { return active.size(); }
+    public int usedSlots() { return freeSlots.length - nFree; }
+
+    // ================================================================== siklus muat / buang
+
+    /** Dipanggil tiap frame (saat di dunia luar): muat chunk yang mendekat, buang yang menjauh, ambil gambar yang selesai di-bake. */
+    public void update() {
+        int ptx = Math.floorDiv(gp.player.x, ts), pty = Math.floorDiv(gp.player.y, ts);
+
+        // buang yang jauh
+        for (int i = active.size() - 1; i >= 0; i--) {
+            Chunk c = active.get(i);
+            if (distance(c, ptx, pty) > UNLOAD_TILES) deactivate(c);
+        }
+        // yang dekat sekali (isi layar) harus siap sekarang juga, tanpa batas per frame (biasanya sudah dimuat lebih dulu)
+        for (Chunk c : chunks) {
+            if (distance(c, ptx, pty) > forceTiles) continue;
+            if (!c.active) activate(c);
+            if (!c.bakeDone) { pollBake(c, true); syncBakes++; }
+        }
+        // muat yang dekat, yang paling dekat dulu
+        int made = 0;
+        while (made < MAX_ACTIVATE_PER_FRAME) {
+            Chunk best = null;
+            int bestD = Integer.MAX_VALUE;
+            for (Chunk c : chunks) {
+                if (c.active) continue;
+                int d = distance(c, ptx, pty);
+                if (d <= LOAD_TILES && d < bestD) { best = c; bestD = d; }
+            }
+            if (best == null) break;
+            activate(best);
+            made++;
+        }
+        // gambar yang sudah selesai
+        for (Chunk c : active) pollBake(c, false);
+        // kasih tahu thread gambar kalau daftar chunk aktif berubah
+        if (viewDirty) { view = active.toArray(new Chunk[0]); viewDirty = false; }
+    }
+
+    private int distance(Chunk c, int ptx, int pty) {
+        int dx = Math.max(Math.max(c.col0 - ptx, ptx - (c.col0 + CH - 1)), 0);
+        int dy = Math.max(Math.max(c.row0 - pty, pty - (c.row0 + CH - 1)), 0);
+        return Math.max(dx, dy);
+    }
+
+    private void activate(Chunk c) {
+        c.active = true;
+        c.bakeDone = false;
+        c.baked = null;
+        active.add(c);
+        viewDirty = true;
+        activations++;
+
+        // 1) tile dasar area baru
+        int cEnd = Math.min(c.col0 + CH, WorldGen.WORLD_COLS), rEnd = Math.min(c.row0 + CH, WorldGen.WORLD_ROWS);
+        for (int col = c.col0; col < cEnd; col++) {
+            for (int row = c.row0; row < rEnd; row++) {
+                if (!gen.inCore(col, row)) tm.mapTileNum[col][row] = gen.groundTile(col, row);
+            }
+        }
+
+        // 2) gambar salju / es: di thread lain
+        final int col0 = c.col0, row0 = c.row0;
+        c.future = baker.submit(() -> {
+            try {
+                return IceGround.bake(gen, col0, row0, CH);
+            } catch (Throwable t) {
+                t.printStackTrace();
+                return null;
+            }
+        });
+
+        // 3) objek
+        List<WorldGen.Spawn> spawns = gen.populate(c.col0, c.row0, CH, ts);
+        int nBreak = 0, nDecor = 0;
+        for (WorldGen.Spawn s : spawns) { if (isDecor(s.kind)) nDecor++; else nBreak++; }
+        c.slots = new int[nBreak];
+        Decor d = new Decor(nDecor);
+        int usedDecor = 0;
+        int usedBreak = 0;
+        for (WorldGen.Spawn s : spawns) {
+            if (isDecor(s.kind)) {
+                BufferedImage img = decorImage(s);
+                if (img == null) continue;
+                int i = usedDecor++;
+                d.x[i] = s.x; d.y[i] = s.y; d.w[i] = s.w; d.h[i] = s.h; d.kind[i] = (byte) s.kind; d.img[i] = img;
+            } else {
+                if (nFree == 0) continue;               // kolam habis: lewati objek ini (tidak crash)
+                int slot = freeSlots[--nFree];
+                breakable b = create(s);
+                if (b == null) { freeSlots[nFree++] = slot; continue; }
+                tm.breakables[slot] = b;
+                tm.breakableTile[slot] = (s.kind == WorldGen.K_ICE_ROCK || s.kind == WorldGen.K_CRYSTAL || s.kind == WorldGen.K_ROCK) ? 71 : 55;
+                c.slots[usedBreak++] = slot;
+            }
+        }
+        if (usedBreak < c.slots.length) c.slots = java.util.Arrays.copyOf(c.slots, usedBreak);
+        // hiasan yang gagal dibuat (gambar null) dibuang dari ujung: ukuran sebenarnya = usedDecor
+        c.decor = usedDecor == nDecor ? d : trim(d, usedDecor);
+    }
+
+    private static Decor trim(Decor d, int n) {
+        Decor t = new Decor(n);
+        System.arraycopy(d.x, 0, t.x, 0, n); System.arraycopy(d.y, 0, t.y, 0, n);
+        System.arraycopy(d.w, 0, t.w, 0, n); System.arraycopy(d.h, 0, t.h, 0, n);
+        System.arraycopy(d.kind, 0, t.kind, 0, n); System.arraycopy(d.img, 0, t.img, 0, n);
+        return t;
+    }
+
+    private void deactivate(Chunk c) {
+        c.active = false;
+        active.remove(c);
+        viewDirty = true;
+        deactivations++;
+        for (int slot : c.slots) {
+            breakable b = tm.breakables[slot];
+            if (b != null) b.unregister();
+            tm.breakables[slot] = null;
+            freeSlots[nFree++] = slot;
+        }
+        c.slots = new int[0];
+        c.decor = Decor.EMPTY;
+        c.baked = null;
+        if (c.future != null) c.future.cancel(false);
+        c.future = null;
+        c.bakeDone = false;
+        // sel area baru yang tidak termuat dianggap air (tidak bisa dilewati pathfinding)
+        int cEnd = Math.min(c.col0 + CH, WorldGen.WORLD_COLS), rEnd = Math.min(c.row0 + CH, WorldGen.WORLD_ROWS);
+        for (int col = c.col0; col < cEnd; col++) {
+            for (int row = c.row0; row < rEnd; row++) {
+                if (!gen.inCore(col, row)) tm.mapTileNum[col][row] = 2;
+            }
+        }
+    }
+
+    private void pollBake(Chunk c, boolean wait) {
+        if (c.bakeDone || c.future == null) return;
+        if (!wait && !c.future.isDone()) return;
+        try {
+            c.baked = c.future.get();
+        } catch (InterruptedException | ExecutionException | java.util.concurrent.CancellationException e) {
+            c.baked = null;
+        }
+        c.bakeDone = true;
+    }
+
+    // ================================================================== bikin objek
+
+    private static boolean isDecor(int kind) {
+        return kind == WorldGen.K_BUSH || kind == WorldGen.K_BUSH_SNOW || kind == WorldGen.K_GLOW
+            || (kind >= WorldGen.K_TUFT && kind <= WorldGen.K_DRIFT);
+    }
+
+    private BufferedImage decorImage(WorldGen.Spawn s) {
+        switch (s.kind) {
+            case WorldGen.K_BUSH: return bushImg;
+            case WorldGen.K_BUSH_SNOW: return snowBushImg;
+            case WorldGen.K_GLOW: return spr.glow;
+            case WorldGen.K_TUFT: return spr.tuft[s.variant & 1];
+            case WorldGen.K_PEBBLE: return spr.pebble[s.variant & 1];
+            case WorldGen.K_SHARD: return spr.shard[s.variant & 1];
+            case WorldGen.K_DRIFT: return spr.drift[s.variant & 1];
+            default: return null;
+        }
+    }
+
+    private breakable create(WorldGen.Spawn s) {
+        Item drop = ItemManager.get().ORE;
+        BufferedImage img;
+        BufferedImage[] idle = null, hit = null, down = null;
+        boolean shadow = false;
+        double[] col = null;
+        int v = s.variant;
+        switch (s.kind) {
+            case WorldGen.K_OAK:
+                img = oakIdle[0]; idle = oakIdle; hit = oakHit; down = oakDown;
+                drop = ItemManager.get().LOG; shadow = true; break;
+            case WorldGen.K_OAK_FROST:
+                img = frostIdle[0]; idle = frostIdle; hit = frostHit; down = frostDown;
+                drop = ItemManager.get().LOG; shadow = true; break;
+            case WorldGen.K_PINE:
+                img = spr.pine[v % spr.pine.length]; hit = spr.pineHit[v % spr.pine.length]; down = spr.pineDown[v % spr.pine.length];
+                drop = ItemManager.get().LOG; col = new double[] {0.38, 0.72, 0.24, 0.16}; break;
+            case WorldGen.K_DEAD:
+                img = spr.dead[v % spr.dead.length]; hit = spr.deadHit[v % spr.dead.length]; down = spr.deadDown[v % spr.dead.length];
+                drop = ItemManager.get().LOG; col = new double[] {0.37, 0.80, 0.26, 0.12}; break;
+            case WorldGen.K_ICE_ROCK:
+                img = spr.rock[v % spr.rock.length]; col = new double[] {0.14, 0.46, 0.72, 0.32}; break;
+            case WorldGen.K_CRYSTAL:
+                img = spr.crystal[v % spr.crystal.length]; col = new double[] {0.18, 0.62, 0.64, 0.26}; break;
+            case WorldGen.K_ROCK:
+                img = rockImg; break;
+            default:
+                return null;
+        }
+        if (img == null) return null;
+        breakable b = new breakable(s.x, s.y, s.w, s.h, img, s.hp, drop, gp);
+        b.hasShadow = shadow;
+        if (col != null) b.setCollisionFractions(col[0], col[1], col[2], col[3]);
+        if (idle != null) b.setIdleFrames(idle);
+        if (hit != null) b.setHitFrames(hit);
+        if (down != null) b.setDownFrames(down);
+        return b;
+    }
+
+    // ================================================================== gambar
+
+    /**
+     * true kalau tile (col, row) tertutup penuh oleh gambar salju / es yang sudah siap, jadi tile dasarnya tidak perlu
+     * digambar (hasil di layar sama persis, tapi jauh lebih ringan di tengah biome es).
+     */
+    public boolean isCovered(int col, int row) {
+        if (col < 0 || row < 0) return false;
+        int cx = col / CH, cy = row / CH;
+        if (cx >= ncx || cy >= ncy) return false;
+        Chunk c = chunks[cy * ncx + cx];
+        IceGround.Result r = c.baked;
+        return r != null && r.covered[(row - c.row0) * CH + (col - c.col0)];
+    }
+
+    /** Salju / es dan cahaya kristal: digambar tepat di atas tile dasar, di bawah semua objek. */
+    public void drawGround(Graphics2D g2, int camX, int camY) {
+        int sxOff = gp.player.screenX - camX, syOff = gp.player.screenY - camY;
+        int size = CH * ts;
+        int vx0 = gp.viewMinX(), vx1 = gp.viewMaxX(), vy0 = gp.viewMinY(), vy1 = gp.viewMaxY();
+        Chunk[] vs = view;
+        for (Chunk c : vs) {
+            int sx = c.col0 * ts + sxOff, sy = c.row0 * ts + syOff;
+            if (sx + size < vx0 || sx > vx1 || sy + size < vy0 || sy > vy1) continue;
+            IceGround.Result r = c.baked;
+            if (r != null) g2.drawImage(r.image, sx, sy, size, size, null);
+        }
+        // cahaya kristal berdenyut pelan
+        Composite old = null;
+        float pulse = 0.70f + 0.30f * (float) Math.sin(System.nanoTime() / 1.1e9);
+        for (Chunk c : vs) {
+            Decor d = c.decor;
+            for (int i = 0; i < d.n; i++) {
+                if (d.kind[i] != WorldGen.K_GLOW) continue;
+                int sx = d.x[i] + sxOff, sy = d.y[i] + syOff;
+                if (sx + d.w[i] < vx0 || sx > vx1 || sy + d.h[i] < vy0 || sy > vy1) continue;
+                if (old == null) old = g2.getComposite();
+                g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, pulse));
+                g2.drawImage(d.img[i], sx, sy, d.w[i], d.h[i], null);
+            }
+        }
+        if (old != null) g2.setComposite(old);
+    }
+
+    /** Tambahkan hiasan berdiri (semak) yang terlihat ke daftar urut-Y. Format entri: {sortY, 7, chunkIndex * 4096 + nomor}. */
+    public void collectDecor(List<int[]> drawList, int camX, int camY, int margin) {
+        int sxOff = gp.player.screenX - camX, syOff = gp.player.screenY - camY;
+        int vx0 = gp.viewMinX() - margin, vx1 = gp.viewMaxX() + margin, vy0 = gp.viewMinY() - margin, vy1 = gp.viewMaxY() + margin;
+        for (Chunk c : view) {
+            int ci = c.cy * ncx + c.cx;
+            Decor d = c.decor;
+            for (int i = 0; i < d.n; i++) {
+                if (d.kind[i] == WorldGen.K_GLOW) continue;
+                int sx = d.x[i] + sxOff, sy = d.y[i] + syOff;
+                if (sx + d.w[i] < vx0 || sx > vx1 || sy + d.h[i] < vy0 || sy > vy1) continue;
+                int k = d.kind[i];
+                int sortY = (k == WorldGen.K_BUSH || k == WorldGen.K_BUSH_SNOW) ? d.y[i] + d.h[i] - 40
+                          : (k == WorldGen.K_DRIFT ? d.y[i] + d.h[i] - 400 : d.y[i] + d.h[i]);   // gundukan salju selalu di bawah objek berdiri
+                drawList.add(new int[] {sortY, 7, ci * 4096 + i});
+            }
+        }
+    }
+
+    public void drawDecor(Graphics2D g2, int packed, int camX, int camY) {
+        Chunk c = chunks[packed / 4096];
+        int i = packed % 4096;
+        Decor d = c.decor;                       // satu kali baca: kalau chunk keburu dibuang, d = EMPTY dan kita berhenti
+        if (i >= d.n) return;
+        int kind = d.kind[i];
+        if (kind == WorldGen.K_BUSH || kind == WorldGen.K_BUSH_SNOW) {
+            // sama dengan semak lama di worldObjects: gambar tile 66 / 69 dengan bayangan
+            tm.drawObject(g2, d.x[i], d.y[i], d.w[i], d.h[i], kind == WorldGen.K_BUSH ? 66 : 69, camX, camY, 1);
+            return;
+        }
+        int sx = d.x[i] - camX + gp.player.screenX, sy = d.y[i] - camY + gp.player.screenY;
+        if (sx + d.w[i] < gp.viewMinX() || sx > gp.viewMaxX() || sy + d.h[i] < gp.viewMinY() || sy > gp.viewMaxY()) return;
+        g2.drawImage(d.img[i], sx, sy, d.w[i], d.h[i], null);
+    }
+
+    // ================================================================== tes / debug
+
+    /** daftar chunk aktif: {cx, cy, adaOverlay(0/1), jumlahObjek} */
+    public int[][] describeActive() {
+        int[][] out = new int[active.size()][];
+        for (int i = 0; i < out.length; i++) {
+            Chunk c = active.get(i);
+            out[i] = new int[] {c.cx, c.cy, c.baked != null ? 1 : 0, c.slots.length + c.decor.n};
+        }
+        return out;
+    }
+
+    public void shutdown() { baker.shutdownNow(); }
+}
diff --git a/2DGame/src/bahan/IceGround.java b/2DGame/src/bahan/IceGround.java
new file mode 100644
index 0000000..c614722
--- /dev/null
+++ b/2DGame/src/bahan/IceGround.java
@@ -0,0 +1,254 @@
+package bahan;
+
+import java.awt.image.BufferedImage;
+
+/**
+ * Menggambar "kulit" salju + es untuk satu chunk peta (di-bake sekali, lalu tinggal ditempel tiap frame).
+ *
+ * Hasilnya gambar RGBA {@link #PPT} piksel per tile. Piksel yang tidak tertutup salju dibiarkan transparan,
+ * jadi rumput di bawahnya kelihatan: makin ke tengah biome es makin banyak piksel salju (dither + gumpalan),
+ * dan makin ke pinggir makin jarang, sampai akhirnya cuma tinggal bercak salju tipis di rumput.
+ * Itu yang bikin peralihan hutan -> salju halus, bukan garis potong.
+ *
+ * Murni fungsi dari koordinat dunia (pakai noise global), jadi dua chunk bersebelahan nyambung tanpa sambungan,
+ * dan chunk yang dibuang lalu dibuat lagi hasilnya persis sama.
+ */
+public final class IceGround {
+
+    private IceGround() {}
+
+    /** piksel seni per tile (sama dengan resolusi animasi air: 48 px layar / 3 px per piksel seni) */
+    public static final int PPT = 16;
+
+    // ------------------------------------------------------------------ palet (ARGB)
+    static final int SN_HI   = 0xFFFAFDFF;
+    static final int SN_1    = 0xFFE9F2FB;
+    static final int SN_2    = 0xFFD5E5F4;
+    static final int SN_3    = 0xFFBFD3E9;
+    static final int SN_RIM  = 0xFFA6BEDB;
+    static final int SPARK   = 0xFFFFFFFF;
+
+    static final int IC_HI    = 0xFFE6F6FE;
+    static final int IC_LIGHT = 0xFFB9E0F6;
+    static final int IC_MID   = 0xFF92C9EB;
+    static final int IC_DEEP  = 0xFF74B3E0;
+    static final int IC_DARK  = 0xFF5B9BCF;
+    static final int IC_EDGE  = 0xFF4F89BE;
+    static final int IC_CRACK_L = 0xFFF3FBFF;
+    static final int IC_CRACK_D = 0xFF5A94C6;
+
+    private static final int NS1 = 0x51A3, NS2 = 0x2B77, NS3 = 0x7C13, NS4 = 0x1D55, NS5 = 0x6E21, NS6 = 0x3F09, NS7 = 0x5B8D;
+
+    private static final byte M_NONE = 0, M_SNOW = 1, M_ICE = 2;
+
+    /** Hasil bake satu chunk: gambar + penanda tile mana yang tertutup penuh (tile di bawahnya tidak perlu digambar). */
+    public static final class Result {
+        public final BufferedImage image;
+        /** [baris * size + kolom] = true kalau semua piksel tile itu tidak transparan */
+        public final boolean[] covered;
+        Result(BufferedImage image, boolean[] covered) { this.image = image; this.covered = covered; }
+    }
+
+    /**
+     * @return gambar (size*PPT) x (size*PPT) beserta tile yang tertutup penuh, atau null kalau chunk ini sama sekali tidak ada salju.
+     */
+    public static Result bake(WorldGen gen, int col0, int row0, int size) {
+        final int W = size * PPT;
+        final int PW = W + 2;                 // lebar dengan pinggiran 1 px (untuk bayangan tepi yang pas di batas chunk)
+
+        // --- ice() dan depth() di kisi 1/2 tile, mulai dari 1 tile sebelum chunk
+        final int GS = (size + 2) * 2 + 1;
+        float[] iceG = new float[GS * GS];
+        float[] depG = new float[GS * GS];
+        float maxIce = 0f;
+        for (int gy = 0; gy < GS; gy++) {
+            for (int gx = 0; gx < GS; gx++) {
+                float tx = col0 - 1 + gx * 0.5f, ty = row0 - 1 + gy * 0.5f;
+                float iv = gen.ice(tx, ty);
+                iceG[gy * GS + gx] = iv;
+                if (iv > maxIce) maxIce = iv;
+                depG[gy * GS + gx] = iv > 0.55f ? gen.depth(tx, ty, iv) : -9f;
+            }
+        }
+        if (maxIce < 0.04f) return null;
+
+        // --- tile mana yang boleh tertutup salju (pinggiran 1 tile)
+        final int TS = size + 2;
+        boolean[] elig = new boolean[TS * TS];
+        for (int r = 0; r < TS; r++) {
+            for (int c = 0; c < TS; c++) {
+                int cc = col0 - 1 + c, rr = row0 - 1 + r;
+                boolean ok = false;
+                if (cc >= 0 && rr >= 0 && cc < WorldGen.WORLD_COLS && rr < WorldGen.WORLD_ROWS) {
+                    ok = WorldGen.isGrassLike(gen.baseTile(cc, rr));
+                }
+                elig[r * TS + c] = ok;
+            }
+        }
+
+        byte[] mask = new byte[PW * PW];
+        int[] colr = new int[PW * PW];
+        final int gx0 = col0 * PPT - 1, gy0 = row0 * PPT - 1;      // koordinat piksel seni dunia dari piksel (0,0) berpinggiran
+        boolean any = false;
+
+        for (int py = 0; py < PW; py++) {
+            int gy = gy0 + py;
+            int tr = Math.floorDiv(gy, PPT) - (row0 - 1);
+            float v = (py + 0.5f) / 8f;                            // posisi di kisi 1/2 tile (1 sel = 8 piksel seni)
+            int v0 = (int) v; if (v0 > GS - 2) v0 = GS - 2;
+            float fv = v - v0;
+            for (int px = 0; px < PW; px++) {
+                int gx = gx0 + px;
+                int tc = Math.floorDiv(gx, PPT) - (col0 - 1);
+                if (!elig[tr * TS + tc]) continue;
+
+                float u = (px + 0.5f) / 8f;
+                int u0 = (int) u; if (u0 > GS - 2) u0 = GS - 2;
+                float fu = u - u0;
+                int i00 = v0 * GS + u0;
+                float iv = lerp2(iceG[i00], iceG[i00 + 1], iceG[i00 + GS], iceG[i00 + GS + 1], fu, fv);
+                if (iv < 0.03f) continue;
+
+                float white = WorldGen.rnd(gx, gy, NS3);
+                float clump = 0.55f * WorldGen.vnoise(gx * 0.060f, gy * 0.060f, NS1)
+                            + 0.30f * WorldGen.vnoise(gx * 0.150f + 7f, gy * 0.150f + 3f, NS2)
+                            + 0.15f * WorldGen.vnoise(gx * 0.330f + 2f, gy * 0.330f + 9f, NS4);
+                float t = 0.84f * clump + 0.16f * white;
+                t = (t - 0.20f) / 0.60f;
+                if (t > 1f) t = 1f;
+                float cover = smoothstep(0.04f, 0.70f, iv) * 1.10f;
+                boolean snow = cover > t;
+
+                // ---- danau / sungai beku
+                boolean ice = false;
+                float dpn = -9f;
+                if (iv > 0.6f) {
+                    float d00 = depG[i00], d01 = depG[i00 + 1], d10 = depG[i00 + GS], d11 = depG[i00 + GS + 1];
+                    if (d00 > -8f && d01 > -8f && d10 > -8f && d11 > -8f) {
+                        float dp = lerp2(d00, d01, d10, d11, fu, fv);
+                        dpn = dp + (WorldGen.vnoise(gx * 0.22f, gy * 0.22f, NS4) - 0.5f) * 0.11f + (white - 0.5f) * 0.02f;
+                        ice = dpn > 0f;
+                    }
+                }
+                if (!snow && !ice) continue;
+
+                int idx = py * PW + px;
+                if (ice) {
+                    mask[idx] = M_ICE;
+                    colr[idx] = iceColor(gx, gy, dpn, white);
+                } else {
+                    mask[idx] = M_SNOW;
+                    colr[idx] = snowColor(gx, gy, white, dpn > -0.34f && dpn <= 0f);
+                }
+                any = true;
+            }
+        }
+        if (!any) return null;
+
+        // ---- tepi: ketebalan salju (bawah gelap, atas terang) + garis bayangan di tepi es
+        int[] out = new int[W * W];
+        for (int py = 0; py < W; py++) {
+            for (int px = 0; px < W; px++) {
+                int idx = (py + 1) * PW + (px + 1);
+                byte m = mask[idx];
+                if (m == M_NONE) continue;
+                byte up = mask[idx - PW], dn = mask[idx + PW];
+                int c = colr[idx];
+                if (m == M_SNOW) {
+                    if (dn == M_NONE) c = SN_RIM;
+                    else if (dn == M_ICE) c = SN_3;
+                    else if (up == M_NONE) c = SN_HI;
+                } else {
+                    if (up == M_SNOW) c = IC_EDGE;
+                    else if (dn == M_SNOW) c = IC_HI;
+                    else if (mask[idx - 1] == M_SNOW || mask[idx + 1] == M_SNOW) c = IC_DARK;
+                }
+                out[py * W + px] = c;
+            }
+        }
+        boolean[] covered = new boolean[size * size];
+        for (int tr = 0; tr < size; tr++) {
+            for (int tc = 0; tc < size; tc++) {
+                boolean full = true;
+                scan:
+                for (int y = tr * PPT; y < (tr + 1) * PPT; y++) {
+                    int base = y * W + tc * PPT;
+                    for (int x = 0; x < PPT; x++) {
+                        if ((out[base + x] >>> 24) == 0) { full = false; break scan; }
+                    }
+                }
+                covered[tr * size + tc] = full;
+            }
+        }
+        BufferedImage img = new BufferedImage(W, W, BufferedImage.TYPE_INT_ARGB);
+        img.setRGB(0, 0, W, W, out, 0, W);
+        return new Result(img, covered);
+    }
+
+    // ------------------------------------------------------------------ warna
+
+    private static int snowColor(int gx, int gy, float white, boolean bank) {
+        float drift = 0.80f * WorldGen.fbm(gx * 0.030f, gy * 0.030f, NS5, 3) + 0.20f * WorldGen.vnoise(gx * 0.12f, gy * 0.12f, NS6);
+        if (bank) drift += 0.14f;
+        // garis angin tipis (jengger salju yang tertiup)
+        float ridge = (float) Math.sin((gx + gy * 0.55f) * 0.15f + WorldGen.vnoise(gx * 0.03f, gy * 0.03f, NS7) * 11f);
+        if (white < 0.0065f) return SPARK;
+        if (ridge > 0.968f && drift > 0.40f) return SN_HI;
+        if (white > 0.994f) return SN_2;
+        if (drift < 0.27f) return SN_3;
+        if (drift < 0.38f) return SN_2;
+        if (drift > 0.63f) return SN_HI;
+        return SN_1;
+    }
+
+    private static int iceColor(int gx, int gy, float dpn, float white) {
+        // retakan: jarak ke tepi sel Voronoi (sel besar ~ 2 tile)
+        final float CS = 34f;
+        float px = gx / CS, py = gy / CS;
+        int cx = (int) Math.floor(px), cy = (int) Math.floor(py);
+        float f1 = 1e9f, f2 = 1e9f;
+        int id1 = 0, id2 = 0;
+        for (int j = -1; j <= 1; j++) {
+            for (int i = -1; i <= 1; i++) {
+                int ax = cx + i, ay = cy + j;
+                float sx = ax + WorldGen.rnd(ax, ay, 0x1A2B);
+                float sy = ay + WorldGen.rnd(ax, ay, 0x3C4D);
+                float dx = (sx - px) * CS, dy = (sy - py) * CS;
+                float d = dx * dx + dy * dy;
+                int id = WorldGen.h2(ax, ay, 0x55);
+                if (d < f1) { f2 = f1; id2 = id1; f1 = d; id1 = id; }
+                else if (d < f2) { f2 = d; id2 = id; }
+            }
+        }
+        float gap = (float) (Math.sqrt(f2) - Math.sqrt(f1));
+        if (((id1 ^ id2) & 3) != 0) {
+            if (gap < 0.9f) return IC_CRACK_L;
+            if (gap < 1.7f) return IC_CRACK_D;
+        }
+        // goresan pantulan miring
+        float streak = (gx * 0.8f + gy * 1.0f) * 0.05f + WorldGen.vnoise(gx * 0.04f, gy * 0.04f, NS6) * 6f;
+        float fr = streak - (float) Math.floor(streak);
+        if (fr < 0.06f) return IC_HI;
+        float n = WorldGen.vnoise(gx * 0.07f, gy * 0.07f, NS2);
+        float depthBias = Math.min(1f, dpn / 1.6f);
+        float lvl = 0.55f * n + 0.45f * depthBias;
+        if (white < 0.012f) return IC_HI;
+        if (lvl < 0.30f) return IC_LIGHT;
+        if (lvl < 0.50f) return IC_MID;
+        if (lvl < 0.70f) return IC_DEEP;
+        return IC_DARK;
+    }
+
+    // ------------------------------------------------------------------ util
+
+    private static float lerp2(float a, float b, float c, float d, float fu, float fv) {
+        float top = a + (b - a) * fu, bot = c + (d - c) * fu;
+        return top + (bot - top) * fv;
+    }
+
+    private static float smoothstep(float a, float b, float x) {
+        float t = (x - a) / (b - a);
+        if (t < 0f) t = 0f; else if (t > 1f) t = 1f;
+        return t * t * (3f - 2f * t);
+    }
+}
diff --git a/2DGame/src/bahan/IceSprites.java b/2DGame/src/bahan/IceSprites.java
new file mode 100644
index 0000000..06e7a52
--- /dev/null
+++ b/2DGame/src/bahan/IceSprites.java
@@ -0,0 +1,253 @@
+package bahan;
+
+import java.awt.AlphaComposite;
+import java.awt.Graphics2D;
+import java.awt.RenderingHints;
+import java.awt.geom.AffineTransform;
+import java.awt.image.BufferedImage;
+import java.io.InputStream;
+
+import javax.imageio.ImageIO;
+
+/**
+ * Gambar-gambar biome es + alat pengolah gambar yang dipakai biome itu:
+ *  - sprite cemara / pohon mati / batu es / kristal / cahaya kristal (folder Aset/ice/, dibuat oleh tools/make_ice_assets.py)
+ *  - animasi kena-pukul dan tumbang untuk pohon es (dibuat dari sprite-nya, jadi tidak perlu aset animasi baru)
+ *  - {@link #frost}: pohon biasa jadi "kena embun beku" (puncak daun bersalju, warna lebih dingin)
+ *  - {@link #snowShore}: tile tepi pantai versi salju (bagian darat putih, bagian air tidak diubah)
+ */
+public final class IceSprites {
+
+    public final BufferedImage[] pine = new BufferedImage[3];
+    public final BufferedImage[] dead = new BufferedImage[2];
+    public final BufferedImage[] rock = new BufferedImage[3];
+    public final BufferedImage[] crystal = new BufferedImage[3];
+    public BufferedImage glow;
+    public final BufferedImage[] drift = new BufferedImage[2], pebble = new BufferedImage[2],
+            shard = new BufferedImage[2], tuft = new BufferedImage[2];
+
+    /** animasi pohon es (dibuat sekali per sprite, dipakai bersama semua pohon sejenis) */
+    public final BufferedImage[][] pineHit = new BufferedImage[3][];
+    public final BufferedImage[][] pineDown = new BufferedImage[3][];
+    public final BufferedImage[][] deadHit = new BufferedImage[2][];
+    public final BufferedImage[][] deadDown = new BufferedImage[2][];
+
+    public IceSprites(Class<?> anchor) {
+        for (int i = 0; i < pine.length; i++) pine[i] = load(anchor, "pine_" + i);
+        for (int i = 0; i < dead.length; i++) dead[i] = load(anchor, "dead_" + i);
+        for (int i = 0; i < rock.length; i++) rock[i] = load(anchor, "rock_" + i);
+        for (int i = 0; i < crystal.length; i++) crystal[i] = load(anchor, "crystal_" + i);
+        glow = load(anchor, "glow");
+        for (int i = 0; i < 2; i++) {
+            drift[i] = load(anchor, "drift_" + i);
+            pebble[i] = load(anchor, "pebble_" + i);
+            shard[i] = load(anchor, "shard_" + i);
+            tuft[i] = load(anchor, "tuft_" + i);
+        }
+        for (int i = 0; i < pine.length; i++) {
+            pineHit[i] = hitFrames(pine[i]);
+            pineDown[i] = downFrames(pine[i]);
+        }
+        for (int i = 0; i < dead.length; i++) {
+            deadHit[i] = hitFrames(dead[i]);
+            deadDown[i] = downFrames(dead[i]);
+        }
+    }
+
+    private static BufferedImage load(Class<?> anchor, String name) {
+        try (InputStream in = anchor.getResourceAsStream("/Aset/ice/" + name + ".png")) {
+            if (in != null) return ImageIO.read(in);
+        } catch (Exception e) {
+            e.printStackTrace();
+        }
+        System.err.println("[IceSprites] Gambar tidak ditemukan: /Aset/ice/" + name + ".png");
+        // supaya game tetap jalan: kotak putih-biru polos
+        BufferedImage fallback = new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < 64; y++) for (int x = 0; x < 64; x++) fallback.setRGB(x, y, 0xFFDCEBF8);
+        return fallback;
+    }
+
+    // ================================================================== animasi pohon es
+
+    /** 4 frame goyang waktu dipukul: bergeser kiri-kanan sedikit sambil miring dari pangkalnya. */
+    static BufferedImage[] hitFrames(BufferedImage full) {
+        BufferedImage idle = half(full);   // animasi cuma sekejap, setengah resolusi cukup (hemat memori)
+        double[] dx = {-0.030, 0.026, -0.016, 0.010};
+        double[] rot = {-0.035, 0.030, -0.018, 0.010};
+        BufferedImage[] out = new BufferedImage[4];
+        int w = idle.getWidth(), h = idle.getHeight();
+        for (int i = 0; i < out.length; i++) {
+            out[i] = blank(w, h);
+            Graphics2D g = out[i].createGraphics();
+            g.setRenderingHint(RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_NEAREST_NEIGHBOR);
+            AffineTransform t = new AffineTransform();
+            t.translate(dx[i] * w, 0);
+            t.rotate(rot[i], w / 2.0, h * 0.88);
+            g.drawImage(idle, t, null);
+            g.dispose();
+        }
+        return out;
+    }
+
+    /** 6 frame tumbang: miring lalu "ambruk" menumpuk ke pangkal (tinggi mengecil, melebar), bagian bawah tetap menempel tanah. */
+    static BufferedImage[] downFrames(BufferedImage full) {
+        BufferedImage idle = half(full);
+        double[] rot = {0.05, 0.10, 0.17, 0.25, 0.32, 0.38};
+        double[] sy = {0.94, 0.82, 0.66, 0.48, 0.32, 0.20};
+        double[] sx = {1.00, 1.04, 1.10, 1.18, 1.26, 1.34};
+        BufferedImage[] out = new BufferedImage[6];
+        int w = idle.getWidth(), h = idle.getHeight();
+        for (int i = 0; i < out.length; i++) {
+            out[i] = blank(w, h);
+            Graphics2D g = out[i].createGraphics();
+            g.setRenderingHint(RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_NEAREST_NEIGHBOR);
+            AffineTransform t = new AffineTransform();
+            t.translate(w / 2.0, h * 0.90);
+            t.rotate(rot[i]);
+            t.scale(sx[i] > 1.3 ? 1.3 : sx[i], sy[i]);
+            t.translate(-w / 2.0, -h * 0.90);
+            if (i >= 4) g.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, i == 4 ? 0.85f : 0.7f));
+            g.drawImage(idle, t, null);
+            g.dispose();
+        }
+        return out;
+    }
+
+    /** Setengah ukuran, tanpa penghalusan (sprite ini dibuat 4x dari piksel seninya, jadi tetap tajam). */
+    private static BufferedImage half(BufferedImage src) {
+        int w = Math.max(1, src.getWidth() / 2), h = Math.max(1, src.getHeight() / 2);
+        BufferedImage out = new BufferedImage(w, h, BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < h; y++) for (int x = 0; x < w; x++) out.setRGB(x, y, src.getRGB(x * 2, y * 2));
+        return out;
+    }
+
+    private static BufferedImage blank(int w, int h) {
+        return new BufferedImage(w, h, BufferedImage.TYPE_INT_ARGB);
+    }
+
+    // ================================================================== pohon biasa "kena embun beku"
+
+    /**
+     * Versi beku dari gambar pohon biasa (kotak seni 12 px pada gambar 768 px): warna daun digeser ke hijau-biru dingin,
+     * puncak kanopi diberi tutup salju 1-3 kotak, dan beberapa kotak daun paling terang jadi bercak salju.
+     * Pola acaknya ditentukan oleh posisi kotak, jadi semua frame animasi pohon (diam / dipukul / tumbang) konsisten.
+     */
+    public static BufferedImage frost(BufferedImage src) {
+        final int B = 12;
+        int w = src.getWidth(), h = src.getHeight();
+        int gw = w / B, gh = h / B;
+        BufferedImage out = new BufferedImage(w, h, BufferedImage.TYPE_INT_ARGB);
+        int[] px = src.getRGB(0, 0, w, h, null, 0, w);
+        int[] res = px.clone();
+
+        // warna tiap kotak = piksel tengahnya
+        int[] cell = new int[gw * gh];
+        for (int by = 0; by < gh; by++) for (int bx = 0; bx < gw; bx++)
+            cell[by * gw + bx] = px[(by * B + B / 2) * w + bx * B + B / 2];
+
+        boolean[] snow = new boolean[gw * gh];
+        int[] snowCol = new int[gw * gh];
+        for (int bx = 0; bx < gw; bx++) {
+            int by = 0;
+            while (by < gh && (cell[by * gw + bx] >>> 24) < 128) by++;
+            if (by >= gh) continue;
+            if (!isLeaf(cell[by * gw + bx])) continue;
+            int depth = 1 + (WorldGen.h2(bx, 3, 77) >>> 5) % 2 + (((WorldGen.h2(bx / 2, 5, 78) >>> 5) % 3 == 0) ? 1 : 0);
+            for (int k = 0; k < depth && by + k < gh; k++) {
+                int idx = (by + k) * gw + bx;
+                if ((cell[idx] >>> 24) < 128) break;
+                snow[idx] = true;
+                snowCol[idx] = k == 0 ? 0xFFFFFFFF : (k < depth - 1 ? 0xFFEAF3FB : 0xFFD3E3F3);
+            }
+        }
+        // bercak salju di kanopi: kotak daun yang paling terang
+        for (int by = 1; by < gh; by++) {
+            for (int bx = 0; bx < gw; bx++) {
+                int idx = by * gw + bx;
+                int c = cell[idx];
+                if ((c >>> 24) < 128 || snow[idx] || !isLeaf(c)) continue;
+                int lum = ((c >> 16 & 255) * 3 + (c >> 8 & 255) * 5 + (c & 255)) / 9;
+                if (lum > 150 && (WorldGen.h2(bx, by, 79) >>> 6) % 100 < 46) {
+                    snow[idx] = true;
+                    snowCol[idx] = ((WorldGen.h2(bx, by, 80) >>> 6) % 3 == 0) ? 0xFFFFFFFF : 0xFFEAF3FB;
+                }
+            }
+        }
+
+        for (int y = 0; y < h; y++) {
+            for (int x = 0; x < w; x++) {
+                int p = px[y * w + x];
+                if ((p >>> 24) == 0) continue;
+                int idx = (y / B) * gw + (x / B);
+                if (idx < snow.length && snow[idx]) { res[y * w + x] = snowCol[idx]; continue; }
+                if (isLeaf(p)) res[y * w + x] = cool(p);
+            }
+        }
+        out.setRGB(0, 0, w, h, res, 0, w);
+        return out;
+    }
+
+    private static boolean isLeaf(int p) {
+        int r = p >> 16 & 255, g = p >> 8 & 255, b = p & 255;
+        return g > r + 6 && g >= b;
+    }
+
+    /** geser warna daun hijau ke hijau kebiruan yang lebih pucat */
+    private static int cool(int p) {
+        int a = p >>> 24, r = p >> 16 & 255, g = p >> 8 & 255, b = p & 255;
+        float k = 0.30f;
+        r = (int) (r * (1 - k) + 128 * k);
+        g = (int) (g * (1 - k) + 188 * k);
+        b = (int) (b * (1 - k) + 186 * k);
+        return a << 24 | r << 16 | g << 8 | b;
+    }
+
+    // ================================================================== tile tepi pantai bersalju
+
+    /**
+     * Ubah tile tepi pantai (air + rumput + tanah di sisinya) jadi versi salju: rumput jadi salju putih-biru, tanah tepi
+     * jadi es abu-biru. Piksel air (warna dasar 0x3B8FCA) DIBIARKAN persis sama, karena WaterAnimator mengenali
+     * "bagian daratan" dari piksel yang bukan warna air itu.
+     */
+    public static BufferedImage snowShore(BufferedImage src) {
+        int w = src.getWidth(), h = src.getHeight();
+        BufferedImage out = new BufferedImage(w, h, BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < h; y++) {
+            for (int x = 0; x < w; x++) {
+                int p = src.getRGB(x, y);
+                int a = p >>> 24;
+                if (a == 0 || (p & 0xFFFFFF) == 0x3B8FCA) { out.setRGB(x, y, p); continue; }
+                int r = p >> 16 & 255, g = p >> 8 & 255, b = p & 255;
+                float lum = (r * 0.3f + g * 0.55f + b * 0.15f) / 255f;
+                int q;
+                if (g > r + 4 && g >= b) {                           // rumput -> salju
+                    float t = clamp((lum - 0.20f) / 0.40f);
+                    q = mix(0xD5E5F4, 0xFAFDFF, t);
+                } else if (r > b + 8) {                              // tanah tepi -> es abu-biru
+                    float t = clamp((lum - 0.18f) / 0.34f);
+                    q = mix(0xA6BEDB, 0xC9DAEC, t);
+                } else {
+                    q = mix(0xC8DAEC, 0xF2F8FD, clamp(lum));
+                }
+                out.setRGB(x, y, a << 24 | q);
+            }
+        }
+        return out;
+    }
+
+    private static float clamp(float v) { return v < 0f ? 0f : (v > 1f ? 1f : v); }
+
+    private static int mix(int a, int b, float t) {
+        int r = (int) ((a >> 16 & 255) * (1 - t) + (b >> 16 & 255) * t);
+        int g = (int) ((a >> 8 & 255) * (1 - t) + (b >> 8 & 255) * t);
+        int bl = (int) ((a & 255) * (1 - t) + (b & 255) * t);
+        return r << 16 | g << 8 | bl;
+    }
+
+    /** gambar polos satu warna (dipakai tile "salju" / "es" khusus minimap) */
+    public static BufferedImage flat(int rgb) {
+        BufferedImage im = new BufferedImage(16, 16, BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < 16; y++) for (int x = 0; x < 16; x++) im.setRGB(x, y, 0xFF000000 | rgb);
+        return im;
+    }
+}
diff --git a/2DGame/src/bahan/SnowAtmosphere.java b/2DGame/src/bahan/SnowAtmosphere.java
new file mode 100644
index 0000000..bd7643e
--- /dev/null
+++ b/2DGame/src/bahan/SnowAtmosphere.java
@@ -0,0 +1,156 @@
+package bahan;
+
+import java.awt.AlphaComposite;
+import java.awt.Color;
+import java.awt.Composite;
+import java.awt.Graphics2D;
+import java.awt.RadialGradientPaint;
+import java.awt.image.BufferedImage;
+import java.util.Random;
+
+import Main.GamePanel;
+
+/**
+ * Suasana biome es, digambar di layar (bukan di dunia) di atas semua objek:
+ *  - hujan salju (partikel, 3 lapis kedalaman, ikut bergeser waktu player jalan supaya terasa berjarak)
+ *  - kabut tipis yang melayang pelan + vignette putih kebiruan di tepi layar
+ *  - sapuan warna dingin (biru-putih) di seluruh layar
+ *
+ * Kekuatannya mengikuti seberapa "bersalju" posisi player (WorldGen.ice), dan berubah pelan-pelan, jadi waktu
+ * player berjalan dari hutan ke salju suasananya beralih halus, bukan tiba-tiba. Di luar biome es semuanya mati
+ * (tidak ada biaya gambar sama sekali).
+ */
+public final class SnowAtmosphere {
+
+    private static final int N = 340;                 // jumlah maksimum serpihan
+    private final GamePanel gp;
+    private final int W, H;
+
+    private float intensity = 0f;                     // 0..1, dihaluskan
+    private float target = 0f;
+    private boolean heavy = false;                    // badai (dipakai kalau lagi hujan di biome es)
+    private float heavyMix = 0f;
+
+    private final float[] bx = new float[N], by = new float[N], depth = new float[N], drift = new float[N], phase = new float[N];
+    private float time = 0f;
+
+    private BufferedImage vignette;                   // sapuan warna dingin + putih kebiruan di tepi layar (satu gambar, satu kali gambar)
+    private BufferedImage fog;                        // gumpalan kabut lembut
+    private final int[] order = new int[N];           // serpihan diurutkan per kedalaman: jauh -> dekat
+    private final int[] classEnd = new int[3];        // batas kelompok (jauh / sedang / dekat) di order[]
+
+    public SnowAtmosphere(GamePanel gp) {
+        this.gp = gp;
+        this.W = gp.screenWidth;
+        this.H = gp.screenHeight;
+        Random rnd = new Random(7);
+        for (int i = 0; i < N; i++) {
+            bx[i] = rnd.nextFloat() * W;
+            by[i] = rnd.nextFloat() * H;
+            depth[i] = 0.30f + 0.70f * rnd.nextFloat() * rnd.nextFloat() + 0.25f * rnd.nextFloat();
+            if (depth[i] > 1f) depth[i] = 1f;
+            drift[i] = (rnd.nextFloat() - 0.5f) * 2f;
+            phase[i] = rnd.nextFloat() * 6.2832f;
+        }
+        // urutkan serpihan per kedalaman supaya bisa digambar per kelompok (alpha sama) tanpa ganti-ganti composite
+        Integer[] idx = new Integer[N];
+        for (int i = 0; i < N; i++) idx[i] = i;
+        java.util.Arrays.sort(idx, (x, y) -> Float.compare(depth[x], depth[y]));
+        for (int i = 0; i < N; i++) order[i] = idx[i];
+        int c0 = 0, c1 = 0;
+        for (int i = 0; i < N; i++) { if (depth[order[i]] < 0.55f) c0 = i + 1; if (depth[order[i]] < 0.82f) c1 = i + 1; }
+        classEnd[0] = c0; classEnd[1] = c1; classEnd[2] = N;
+        buildSprites();
+    }
+
+    private void buildSprites() {
+        vignette = new BufferedImage(W, H, BufferedImage.TYPE_INT_ARGB);
+        Graphics2D g = vignette.createGraphics();
+        g.setColor(new Color(150, 195, 240, 38));            // sapuan warna dingin di seluruh layar
+        g.fillRect(0, 0, W, H);
+        float r = (float) Math.hypot(W, H) * 0.55f;
+        g.setPaint(new RadialGradientPaint(W / 2f, H / 2f, r, new float[] {0f, 0.55f, 1f},
+                new Color[] {new Color(225, 238, 255, 0), new Color(225, 238, 255, 18), new Color(225, 238, 255, 150)}));
+        g.fillRect(0, 0, W, H);
+        g.dispose();
+
+        int fw = 720, fh = 360;
+        fog = new BufferedImage(fw, fh, BufferedImage.TYPE_INT_ARGB);
+        g = fog.createGraphics();
+        g.setPaint(new RadialGradientPaint(fw / 2f, fh / 2f, fw / 2f, new float[] {0f, 1f},
+                new Color[] {new Color(235, 245, 255, 120), new Color(235, 245, 255, 0)}));
+        g.scale(1.0, fh / (double) fw);
+        g.fillRect(0, 0, fw, fw);
+        g.dispose();
+    }
+
+    /** kekuatan efek sekarang (0..1); dipakai juga untuk menyembunyikan hujan biasa di biome es */
+    public float intensity() { return intensity; }
+
+    public void setHeavy(boolean heavy) { this.heavy = heavy; }
+
+    /** Dipanggil tiap frame saat di dunia luar. */
+    public void update() {
+        WorldGen gen = gp.tileM.gen;
+        if (gen != null && gp.player != null) {
+            float ice = gen.ice((gp.player.x + gp.tileSize / 2f) / gp.tileSize, (gp.player.y + gp.tileSize / 2f) / gp.tileSize);
+            // sama dengan kapan tanah mulai ditutupi salju: mulai terasa di pinggir, penuh di dalam
+            float t = (ice - 0.10f) / 0.60f;
+            target = t < 0f ? 0f : (t > 1f ? 1f : t * t * (3f - 2f * t));
+        }
+        // naik pelan (~3 detik), turun pelan (~4 detik)
+        intensity += (target - intensity) * (target > intensity ? 0.012f : 0.009f);
+        if (Math.abs(target - intensity) < 0.002f) intensity = target;
+        heavyMix += ((heavy ? 1f : 0f) - heavyMix) * 0.02f;
+        time += 1f / gp.FPS;
+    }
+
+    /** Gambar di layar normal (sesudah transform zoom dunia dilepas). */
+    public void draw(Graphics2D g2) {
+        if (intensity < 0.01f) return;
+        Composite old = g2.getComposite();
+        float in = intensity;
+
+        // 1) sapuan warna dingin + vignette putih kebiruan (satu gambar)
+        g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, Math.min(1f, in * (0.88f + 0.12f * heavyMix))));
+        g2.drawImage(vignette, 0, 0, null);
+
+        // 2) kabut melayang
+        g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, Math.min(1f, (0.55f + 0.30f * heavyMix) * in)));
+        for (int i = 0; i < 2; i++) {
+            float speed = 9f + 6f * i;
+            int fw = fog.getWidth(), fh = fog.getHeight();
+            float cycle = W + fw;
+            float x = ((time * speed + i * 420f + gp.player.x * 0.05f) % cycle) - fw;
+            int y = (int) (H * (0.20f + 0.40f * i) + Math.sin(time * 0.15f + i * 2f) * 22f - gp.player.y * 0.02f % 40f);
+            g2.drawImage(fog, (int) x, y, null);
+        }
+
+        // 3) serpihan salju, digambar per kelompok kedalaman
+        int count = (int) (N * (0.30f + 0.70f * in) * (0.65f + 0.35f * heavyMix));
+        float camX = gp.player.x, camY = gp.player.y;
+        float wind = 22f + 38f * heavyMix;
+        float fall = 36f + 40f * heavyMix;
+        float[] classAlpha = {0.50f, 0.72f, 0.92f};
+        int[] classSize = {2, 3, 4};
+        int start = 0;
+        for (int cls = 0; cls < 3; cls++) {
+            int end = Math.min(classEnd[cls], N);
+            g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, classAlpha[cls] * Math.min(1f, in * 1.2f)));
+            g2.setColor(cls == 2 ? Color.WHITE : new Color(238, 246, 255));
+            int size = classSize[cls];
+            for (int k = start; k < end; k++) {
+                int i = order[k];
+                if ((i * 7919) % N >= count) continue;               // sebagian serpihan dimatikan kalau lebih tenang
+                float d = depth[i];
+                float sx = bx[i] + time * (wind * d * 0.55f + drift[i] * 8f) + (float) Math.sin(time * 1.3f + phase[i]) * 9f * d - camX * 0.45f * d;
+                float sy = by[i] + time * fall * (0.35f + 0.65f * d) - camY * 0.45f * d;
+                sx = ((sx % W) + W) % W;
+                sy = ((sy % H) + H) % H;
+                g2.fillRect((int) sx, (int) sy, size, size);
+            }
+            start = end;
+        }
+        g2.setComposite(old);
+    }
+}
