-def hn(x, y, s=0):
-    """angka acak deterministik 0..1 per piksel (supaya bulu gak berkedip antar render)."""
-    h = (x * 374761393 + y * 668265263 + s * 2147483647 + 1442695040888963407) & 0xFFFFFFFF
-    h = ((h ^ (h >> 13)) * 1274126177) & 0xFFFFFFFF
-    h ^= h >> 16
-    return (h & 0xFFFF) / 65535.0
