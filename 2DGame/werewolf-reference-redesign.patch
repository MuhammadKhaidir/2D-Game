-def sh(M, dx, dy):
-    """S[y,x] = M[y-dy, x-dx] (geser, sisi kosong = False)."""
-    S = np.zeros_like(M)
-    ys = slice(max(0, dy), H + min(0, dy))
-    xs = slice(max(0, dx), W + min(0, dx))
-    yd = slice(max(0, -dy), H + min(0, -dy))
-    xd = slice(max(0, -dx), W + min(0, -dx))
-    S[ys, xs] = M[yd, xd]
-    return S
-
-
-def lerp(a, b, t):
-    return a + (b - a) * t
