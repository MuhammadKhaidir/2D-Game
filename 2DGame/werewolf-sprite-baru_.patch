+#!/usr/bin/env python3
+"""
+Generator sprite "Werewolf" (manusia serigala daratan es) -- gaya pixel-art yang SAMA dengan player / golemite / skeleton:
+
+  * frame 64 x 64, telapak kaki di baris 46, badan di tengah (x = 32)
+  * outline gelap 1px, shading 3-4 tone (cahaya dari kiri atas)
+  * 4 arah ASLI: kanan / kiri / atas (punggung) / bawah (depan)
+
+Sheet: 25 kolom x 4 baris, sel 64 x 64 -> 1600 x 256
+    baris : 0 right | 1 left | 2 up (belakang) | 3 down (depan)
+    kolom : idle x4 | walk x8 | attack x6 (frame ke-4 = cakaran, STRIKE_FRAME=3) | lunge x3 | dead x4
+
+Sheet-nya ditanam sebagai teks base64 di src/Entitas/WerewolfSheetData.java (biar patch murni teks & gak ada file PNG
+yang harus disalin manual). Jalankan dari folder 2DGame (butuh:  pip install pillow):
+    python tools/generate_werewolf_v2.py                    # tulis ulang src/Entitas/WerewolfSheetData.java
+    python tools/generate_werewolf_v2.py --png sheet.png    # ekspor PNG-nya (buat dilihat / diedit di editor gambar)
+    python tools/generate_werewolf_v2.py --preview out.png  # contact sheet 3x (gak nulis apa-apa ke game)
+Ukuran sel & GROUND harus sama dengan Entitas/WerewolfSprite.java.
+"""
+import math
+import sys
+from pathlib import Path
+from PIL import Image, ImageDraw
+
+CELL, GROUND = 64, 46
+IDLE, WALK, ATTACK, LUNGE, DEAD = 4, 8, 6, 3, 4
+COLS = IDLE + WALK + ATTACK + LUNGE + DEAD
+
+
+def C(r, g, b):
+    return (r, g, b, 255)
+
+
+OUT = C(34, 30, 38)
+FUR = [C(46, 44, 66), C(78, 76, 104), C(112, 110, 140), C(152, 150, 180)]      # gelap, sedang, terang, kilau
+FUR_B = [C(66, 64, 86), C(104, 102, 126), C(142, 138, 162), C(176, 172, 192)]   # moncong / dada (lebih terang)
+FUR_F = [C(34, 32, 50), C(58, 56, 80), C(84, 82, 110), C(110, 108, 138)]         # anggota badan sisi jauh
+CLOTH = [C(52, 34, 32), C(88, 60, 46), C(122, 86, 60), C(152, 112, 78)]
+BONE = [C(150, 142, 130), C(200, 192, 176), C(232, 224, 206), C(252, 248, 238)]
+EYE, EYE_G, MOUTH, NOSE = C(255, 62, 46), C(255, 196, 120), C(120, 30, 40), C(20, 18, 24)
+SLASH = [C(176, 190, 226), C(236, 242, 255)]
+
+
+class Cv:
+    def __init__(s):
+        s.im = Image.new('RGBA', (CELL, CELL), (0, 0, 0, 0))
+        s.d = ImageDraw.Draw(s.im)
+
+    def px(s, x, y, col):
+        x, y = int(round(x)), int(round(y))
+        if 0 <= x < CELL and 0 <= y < CELL:
+            s.im.putpixel((x, y), col)
+
+    def ell(s, x, y, rx, ry, col):
+        if rx < 0.5 or ry < 0.5:
+            return
+        s.d.ellipse([round(x - rx), round(y - ry), round(x + rx), round(y + ry)], fill=col)
+
+    def blob(s, x, y, rx, ry, pal, edge=True):
+        if edge:
+            s.ell(x, y, rx + 1, ry + 1, OUT)
+        s.ell(x, y, rx, ry, pal[0])
+        s.ell(x - .8, y - .8, rx - .9, ry - .9, pal[1])
+        if rx >= 3 and ry >= 3:
+            s.ell(x - 1.6, y - 1.8, rx - 2.2, ry - 2.4, pal[2])
+        if rx >= 6 and ry >= 5:
+            s.ell(x - 2.6, y - 3.0, rx - 4.4, ry - 4.2, pal[3])
+
+    def cap(s, a, b, r, pal, edge=True):
+        n = max(2, int(math.dist(a, b) * 2))
+        pts = [(a[0] + (b[0] - a[0]) * i / n, a[1] + (b[1] - a[1]) * i / n) for i in range(n + 1)]
+        if edge:
+            for x, y in pts:
+                s.ell(x, y, r + 1, r + 1, OUT)
+        for x, y in pts:
+            s.ell(x, y, r, r, pal[0])
+        for x, y in pts:
+            s.ell(x - .7, y - .7, r - 1, r - 1, pal[1])
+        if r >= 3:
