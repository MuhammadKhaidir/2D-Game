+             dict(sx=0, an=(6, -12), af=(2, 12), mouth=True),
+             dict(sx=4, by=1, an=(17, 6), af=(9, 12), mouth=True, arc=arcs[3]),
+             dict(sx=5, by=2, an=(14, 12), af=(8, 13), mouth=True, arc=arcs[4]),
+             dict(sx=2, by=1, an=(7, 14), af=(3, 14))][f]
+        return base_side(fn=(4, 0), ff=(-5, 0), **T)
+    if anim == 'lunge':
+        T = [dict(sx=-3, by=4, hy=1, an=(-6, 10), af=(-4, 10), fn=(1, 0), ff=(-5, 0)),
+             dict(sx=6, by=5, an=(14, 3), af=(10, 5), fn=(-8, 5), ff=(-13, 6), air=6, mouth=True),
+             dict(sx=4, by=2, an=(16, 10), af=(11, 11), fn=(6, 0), ff=(-2, 0), mouth=True,
+                  arc=(((46, 18), (58, 26), (50, 38)), False))][f]
+        return base_side(**T)
+    # dead
+    T = [dict(sx=-2, by=1, hy=2, an=(0, 14), af=(-1, 14), fn=(2, 0), ff=(-4, 0), eyes=True),
+         dict(sx=-1, by=7, hy=3, an=(4, 12), af=(1, 12), fn=(5, 0), ff=(-3, 0), eyes=False),
+         dict(sx=5, by=9, hy=5, an=(8, -6), af=(5, -4), fn=(-6, 0), ff=(-12, 0), eyes=False)][f]
+    return base_side(**T)
+
+
+def pose_front(anim, f, back):
+    if anim == 'idle':
+        b = [0, -1, -1, 0][f]
+        d = [0, 0, 1, 1][f]
+        return base_front(by=b, hy=d, hl=(-1, 14 + d), hr=(1, 14 + d), ear=[0, 0, 1, 0][f])
+    if anim == 'walk':
+        p = walk_phase(f)
+        return base_front(by=-round(abs(math.cos(p))), ll=3 * max(0, math.cos(p)), lr=3 * max(0, math.cos(p + math.pi)),
+                          hl=(-1, 14 + round(2 * math.sin(p))), hr=(1, 14 - round(2 * math.sin(p))))
+    if anim == 'attack':
+        a3 = (((46, 8), (42, 32), (17, 38)), True) if not back else (((46, 12), (32, 3), (18, 14)), True)
+        a4 = (((30, 28), (24, 36), (18, 38)), False) if not back else (((24, 8), (20, 10), (18, 14)), False)
+        T = [dict(hr=(4, -14), hl=(-2, 15), mouth=True),
+             dict(by=-1, hr=(6, -18), hl=(-3, 14), mouth=True),
+             dict(hr=(-1, -6), hl=(-2, 15), mouth=True),
+             dict(by=1, hr=(-14, 16), hl=(-2, 15), mouth=True, arc=a3),
+             dict(by=2, hr=(-10, 17), hl=(-2, 15), mouth=True, arc=a4),
+             dict(by=1, hr=(-3, 15), hl=(-1, 15))][f]
+        return base_front(**T)
+    if anim == 'lunge':
+        T = [dict(by=4, hy=1, hl=(-3, 10), hr=(3, 10)),
+             dict(by=5, ll=4, lr=4, hl=(-7, -4), hr=(7, -4), air=6, mouth=True),
+             dict(by=2, hl=(-5, 12), hr=(5, 12), mouth=True, arc=(((20, 24), (32, 36), (44, 24)), False))][f]
+        return base_front(**T)
+    T = [dict(by=1, hy=2, hx=-1, hl=(-3, 13), hr=(3, 13)),
+         dict(by=7, hy=3, hl=(-3, 9), hr=(3, 9), eyes=False)][f]
+    return base_front(**T)
+
+
+def render(anim, f, dire):
+    if anim == 'dead' and f >= 3:
+        im = lying()
+        return im.transpose(Image.FLIP_LEFT_RIGHT) if dire == 'left' else im
+    if dire in ('right', 'left'):
+        P = pose_side(anim, f)
+        im = side(P)
+        if dire == 'left':
+            im = im.transpose(Image.FLIP_LEFT_RIGHT)
+    else:
+        P = pose_front('dead' if (anim == 'dead' and f < 2) else anim, f, dire == 'up') if not (anim == 'dead' and f == 2) else None
+        if P is None:                       # frame ambruk: pakai pose samping
+            im = side(pose_side('dead', 2))
+            return im
+        im = front(P, back=(dire == 'up'))
+    if P['air']:
+        im = shifted(im, -P['air'])
+    return im
+
+
+def build():
+    sheet = Image.new('RGBA', (COLS * CELL, 4 * CELL), (0, 0, 0, 0))
+    seq = [('idle', IDLE), ('walk', WALK), ('attack', ATTACK), ('lunge', LUNGE), ('dead', DEAD)]
+    for r, dire in enumerate(('right', 'left', 'up', 'down')):
+        c = 0
+        for anim, n in seq:
+            for f in range(n):
+                sheet.paste(render(anim, f, dire), (c * CELL, r * CELL))
+                c += 1
+    return sheet
+
+
+def write_java(sheet, path):
+    import base64
+    import io
+    buf = io.BytesIO()
+    sheet.save(buf, 'PNG', optimize=True)
+    b64 = base64.b64encode(buf.getvalue()).decode('ascii')
+    parts = [b64[i:i + 110] for i in range(0, len(b64), 110)]
+    out = ['package Entitas;', '',
+           '/**',
+           ' * DATA sprite werewolf (JANGAN diedit tangan). PNG sheet 1600 x 256 (25 kolom x 4 baris, sel 64 x 64) dalam base64.',
+           ' * Dibuat oleh tools/generate_werewolf_v2.py -- ubah art di sana, lalu jalankan ulang.',
+           ' */',
+           'final class WerewolfSheetData {',
+           '',
+           '    private WerewolfSheetData() { }',
+           '',
+           '    static String base64() {',
+           '        StringBuilder sb = new StringBuilder(%d);' % len(b64),
+           '        for (String s : PARTS) sb.append(s);',
+           '        return sb.toString();',
+           '    }',
+           '',
+           '    private static final String[] PARTS = {']
+    out += ['        "%s",' % p for p in parts]
+    out += ['    };', '}', '']
+    Path(path).write_text('\n'.join(out), encoding='utf-8', newline='\n')
+
+
+def main():
+    here = Path(__file__).resolve().parent
+    sheet = build()
+    argv = sys.argv[1:]
+    if '--preview' in argv:
+        out = argv[argv.index('--preview') + 1]
+        bg = Image.new('RGBA', sheet.size, (70, 110, 70, 255))
+        bg.alpha_composite(sheet)
+        bg = bg.resize((sheet.width * 3, sheet.height * 3), Image.NEAREST)
+        bg.save(out)
+        print('preview ->', out)
+        return
+    if '--png' in argv:
+        out = argv[argv.index('--png') + 1]
+        sheet.save(out)
+        print('png ->', out)
+        return
+    dst = here.parent / 'src' / 'Entitas' / 'WerewolfSheetData.java'
+    write_java(sheet, dst)
+    print('tulis', dst, sheet.size)
+
+
+if __name__ == '__main__':
+    main()
