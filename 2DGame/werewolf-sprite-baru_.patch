+    def poly(s, pts, col, edge=True):
+        s.d.polygon([(round(x), round(y)) for x, y in pts], fill=col)
+        if edge:
+            q = [(round(x), round(y)) for x, y in pts]
+            s.d.line(q + [q[0]], fill=OUT, width=1)
+
+    def line(s, a, b, col):
+        s.d.line([(round(a[0]), round(a[1])), (round(b[0]), round(b[1]))], fill=col, width=1)
+
+    def claws(s, hand, vec, n=3, ln=3.6):
+        L = math.hypot(*vec) or 1
+        ang = math.atan2(vec[1] / L, vec[0] / L)
+        for i in range(n):
+            a = ang + (i - (n - 1) / 2) * 0.55
+            x0, y0 = hand[0] + math.cos(a) * 2.2, hand[1] + math.sin(a) * 2.2
+            x1, y1 = hand[0] + math.cos(a) * (2.2 + ln), hand[1] + math.sin(a) * (2.2 + ln)
+            s.line((x0, y0), (x1, y1), BONE[1])
+            s.px(x1, y1, BONE[3])
+
+    def slash(s, bez, strong=True):
+        (p0, p1, p2) = bez
+        for i in range(0, 25):
+            t = i / 24
+            x = (1 - t) ** 2 * p0[0] + 2 * (1 - t) * t * p1[0] + t * t * p2[0]
+            y = (1 - t) ** 2 * p0[1] + 2 * (1 - t) * t * p1[1] + t * t * p2[1]
+            w = 1 if (t < .15 or t > .85) else 2
+            col = SLASH[1] if strong else SLASH[0]
+            s.ell(x, y, w * .6, w * .6, col)
+
+
+def ik(a, b, l1, l2, bend):
+    dx, dy = b[0] - a[0], b[1] - a[1]
+    d = max(abs(l1 - l2) + .1, min(math.hypot(dx, dy), l1 + l2 - .1))
+    ang = math.atan2(dy, dx)
+    A = math.acos(max(-1, min(1, (l1 * l1 + d * d - l2 * l2) / (2 * l1 * d))))
+    k = ang + bend * A
+    return (a[0] + l1 * math.cos(k), a[1] + l1 * math.sin(k))
+
+
+def shifted(im, dy):
+    out = Image.new('RGBA', im.size, (0, 0, 0, 0))
+    out.paste(im, (0, dy))
