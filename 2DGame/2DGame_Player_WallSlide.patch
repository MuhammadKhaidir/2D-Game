+    /**
+     * Geser player sebesar (dx, dy) sambil mengecek collision per sumbu (wall sliding).
+     *
+     * Dulu seluruh langkah (dx, dy) dicek sekaligus: begitu salah satu sisi kena collision, langkahnya dibatalkan
+     * total, jadi menahan S lalu menambah D di dekat tembok bawah membuat player diam padahal sisi kanan kosong.
+     * Sekarang kalau langkah diagonal terhalang, X dan Y dicoba sendiri-sendiri (X dulu, lalu Y dari posisi baru),
+     * sehingga sumbu yang bebas tetap jalan. Berlaku ke semua arah dan di OUTSIDE, INSIDE, maupun DOMAIN.
+     */
+    private void moveWithCollision(int dx, int dy) {
+        GamePanel.GameState state = gp.gameState;
+        if (state != GamePanel.GameState.OUTSIDE
+                && state != GamePanel.GameState.INSIDE
+                && state != GamePanel.GameState.DOMAIN) return;
+
+        if (!isStepBlocked(dx, dy)) {
+            x += dx;
+            y += dy;
+            return;
+        }
+
+        // Gerak penuh terhalang. Kalau cuma satu tombol arah (dx atau dy = 0) tidak ada sumbu lain untuk dicoba.
+        if (dx == 0 || dy == 0) return;
+
+        boolean movedX = false;
+        boolean movedY = false;
+        if (!isStepBlocked(dx, 0)) { x += dx; movedX = true; }
+        if (!isStepBlocked(0, dy)) { y += dy; movedY = true; }
+        collisionOn = true; // langkah penuh tetap dianggap terhalang
+
+        // Hadapkan sprite ke arah yang benar-benar dijalani (bukan arah tombol yang tertahan tembok).
+        if (movedX && !movedY) direction = dx > 0 ? "right" : "left";
+        else if (movedY && !movedX) direction = dy > 0 ? "down" : "up";
+    }
+
+    /**
+     * True kalau player yang digeser (dx, dy) dari posisinya sekarang bakal nabrak sesuatu.
+     * Murni pengecekan: tidak menggeser player. Hasilnya juga ditaruh di collisionOn.
+     */
+    private boolean isStepBlocked(int dx, int dy) {
+        collisionOn = false;
+
+        if (gp.gameState == GamePanel.GameState.OUTSIDE) {
+            gp.colision.checkObject(this, dx, dy);
+            for (int i = 0; i < gp.npc.length; i++) {
+                if (gp.npc[i] != null) gp.colision.checkEntity(this, gp.npc[i], dx, dy);
+            }
+
+            if (gp.monsters != null) {
+                for (Entity m : gp.monsters) {
+                    if (m != null && !m.isDead) {
+                        gp.colision.checkEntity(this, m, dx, dy);
+                    }
+                }
+            }
+
+            // 🔴 FIX: Menggunakan dx dan dy (bukan jdx/jdy) agar deteksi jalan normal berfungsi
+            if (gp.deathTotemManager != null && gp.deathTotemManager.getMinions() != null) {
+                for (Entity gm : gp.deathTotemManager.getMinions()) {
+                    if (gm instanceof Tamed.GolemMinion && gm.alive) {
+                        gp.colision.checkEntity(this, gm, dx, dy);
+                    }
+                }
+            }
+
+        } else if (gp.gameState == GamePanel.GameState.INSIDE) {
+            Rectangle nextPlayerBox = new Rectangle(x + solidArea.x + dx, y + solidArea.y + dy, solidArea.width, solidArea.height);
+            if (gp.houseManager.checkCollision(nextPlayerBox)) collisionOn = true;
+
+            // 🔴 FIX: Tambahkan deteksi minion saat berada di dalam rumah (INSIDE)
+            if (!collisionOn && gp.deathTotemManager != null && gp.deathTotemManager.getMinions() != null) {
+                for (Entity gm : gp.deathTotemManager.getMinions()) {
+                    if (gm instanceof Tamed.GolemMinion && gm.alive) {
+                        gp.colision.checkEntity(this, gm, dx, dy);
+                    }
+                }
+            }
+
+        } else if (gp.gameState == GamePanel.GameState.DOMAIN) {
+            Rectangle nextPlayerBox = new Rectangle(x + solidArea.x + dx, y + solidArea.y + dy, solidArea.width, solidArea.height);
+
+            if (gp.domainManager.checkCollision(nextPlayerBox)) {
+                collisionOn = true;
+            }
+
+            if (!collisionOn && gp.domainManager != null && gp.domainManager.getSkeletons() != null) {
+                for (Entitas.Skeleton sk : gp.domainManager.getSkeletons()) {
+                    if (sk != null && !sk.isDead) {
+                        Rectangle skBox = new Rectangle(sk.x + sk.solidArea.x, sk.y + sk.solidArea.y, sk.solidArea.width, sk.solidArea.height);
+                        if (nextPlayerBox.intersects(skBox)) {
+                            collisionOn = true;
+                            break;
+                        }
+                    }
+                }
+            }
+
+            if (!collisionOn && gp.domainManager != null) {
+                for (Entitas.Golemite gl : gp.domainManager.getGolemites()) {
+                    if (gl == null || !gl.isAlive()) continue;
+                    Rectangle glBox = new Rectangle(gl.x + gl.solidArea.x, gl.y + gl.solidArea.y, gl.solidArea.width, gl.solidArea.height);
+                    if (nextPlayerBox.intersects(glBox)) {
+                        collisionOn = true;
+                        break;
+                    }
+                }
+            }
+            if (!collisionOn && gp.domainManager != null) {
+                for (Entitas.Golem gl : gp.domainManager.getGolems()) {
+                    if (gl == null || !gl.isAlive()) continue;
+                    Rectangle glBox = new Rectangle(gl.x + gl.solidArea.x, gl.y + gl.solidArea.y, gl.solidArea.width, gl.solidArea.height);
+                    if (nextPlayerBox.intersects(glBox)) {
+                        collisionOn = true;
+                        break;
+                    }
+                }
+            }
+            if (!collisionOn && gp.domainManager != null) {   // Drowned Soldier (Water Domain)
+                for (Entitas.DrownedSoldier ds : gp.domainManager.getDrownedSoldiers()) {
+                    if (ds == null || !ds.isAlive()) continue;
+                    Rectangle dsBox = new Rectangle(ds.x + ds.solidArea.x, ds.y + ds.solidArea.y, ds.solidArea.width, ds.solidArea.height);
+                    if (nextPlayerBox.intersects(dsBox)) {
+                        collisionOn = true;
+                        break;
+                    }
+                }
+            }
+
+            // (Sengaja gak ngecek gp.monsters di sini: itu monster DUNIA LUAR, bukan isi domain. Musuh domain
+            //  - skeleton, golem, golemite, boss - sudah dicek di atas lewat DomainManager.)
+
+            // 🔴 FIX: Tambahin collision antara player dan SkeletonKing (boss), biar gak saling tembus
+            if (!collisionOn && gp.domainManager != null && gp.domainManager.getBossSkeleton() != null) {
+                Entitas.SkeletonKing king = gp.domainManager.getBossSkeleton();
+                if (king.alive) {
+                    Rectangle kingBox = new Rectangle(king.x + king.solidArea.x, king.y + king.solidArea.y, king.solidArea.width, king.solidArea.height);
+                    if (nextPlayerBox.intersects(kingBox)) {
+                        collisionOn = true;
+                    }
+                }
+            }
+
+            // 🔴 FIX: Satukan sistem menggunakan checkEntity bawaan engine agar presisi
+            if (!collisionOn && gp.deathTotemManager != null && gp.deathTotemManager.getMinions() != null) {
+                for (Entity gm : gp.deathTotemManager.getMinions()) {
+                    if (gm instanceof Tamed.GolemMinion && gm.alive) {
+                        gp.colision.checkEntity(this, gm, dx, dy);
+                    }
+                }
+            }
+        }
+
+        return collisionOn;
+    }
