+        a.poly(0xFF3D2E52, p[4 - 2], p[5 - 2], p[6], p[7], p[6] + 1, 13, p[2] + 2, 17);
+        a.poly(0xFF181021, p[8], p[9], p[10], p[11], p[12], p[13], p[12] - 7, 17);
+        a.line(0xFF77579E, 1f, p[6], p[7], p[6] + 1, 13);
