+
+    // ================================================================== kristal kutukan
+
+    private static BufferedImage paintCrystal(int v) {
+        Art a = new Art(28, 36);
+        int[][] pal = {
+            {0xFF8A4DF0, 0xFF5B2BB0, 0xFFD2B0FF},
+            {0xFFC45BE0, 0xFF8A2BA8, 0xFFF0B8FF},
+            {0xFF6C7CF2, 0xFF3F45B4, 0xFFC2C8FF},
