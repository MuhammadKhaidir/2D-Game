     // ===== SETELAN (gampang diubah di sini) =====
-    private static final double WAIT_MIN_SEC     = 2.5;   // paling cepat ikan nyambar
+    private static final double CAST_SEC         = 0.70;  // animasi lempar (ayun joran, pelampung terbang)
