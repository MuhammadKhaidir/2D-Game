diff --git a/2DGame/tools/import_fishing_sheet.py b/2DGame/tools/import_fishing_sheet.py
new file mode 100644
index 0000000..a6c71c1
--- /dev/null
+++ b/2DGame/tools/import_fishing_sheet.py
@@ -0,0 +1,410 @@
+#!/usr/bin/env python3
+"""
+Bikin ikon item mancing + gambar senjata pas diayun dari SATU gambar sheet pixel-art
+(grid 8 x 4, tiap item ada labelnya: broken_bottle, coin_pouch, ... vitality_pearl).
+
+    python3 tools/import_fishing_sheet.py <sheet.png>              # ikon + senjata di tangan
+    python3 tools/import_fishing_sheet.py <sheet.png> icons        # ikon saja
+    python3 tools/import_fishing_sheet.py <sheet.png> held         # senjata di tangan saja
+    python3 tools/import_fishing_sheet.py <sheet.png> preview.png  # + simpan gambar pratinjau semua ikon
+
+Hasil:
+    src/drop/fishing/<slug>.png         ikon 64x64 (backpack, hotbar, item jatuh, kartu tangkapan)
+    src/drop/fishing/held/<slug>.png    7 senjata mancing: lembar frame animasi serang 1024x256
+                                        (kolom = state 1..4 x frame 1..4, baris = up / down / left / right,
+                                        tiap sel 64x64). Dibaca Object/Weapon.java.
+
+Cara kerja senjata di tangan: frame animasi bawaan (src/Aset/Sword* / *Axe*) dibaca, efek tebasan putih
+(warna persis 244,249,248) dipisahin dari senjata lamanya, pose senjata lama (arah, panjang, posisi gagang)
+dihitung, lalu gambar item baru dipasang dengan pose yang sama. Efek tebasan tetap, jadi di Java cukup
+diwarnai ulang sesuai tint di FishingLoot.
+
+Butuh: Pillow, numpy, scipy.   (pip install pillow numpy scipy)
+Catatan: tools/generate_fishing_assets.py masih bisa bikin suara; ikon lamanya gak akan menimpa ikon ini.
+"""
+import math
+import os
+import sys
+
+import numpy as np
+from PIL import Image
+from scipy import ndimage as ndi
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+SRC = os.path.normpath(os.path.join(HERE, "..", "src"))
+ICON_DIR = os.path.join(SRC, "drop", "fishing")
+HELD_DIR = os.path.join(ICON_DIR, "held")
+ASET = os.path.join(SRC, "Aset")
+
+# urutan item di sheet: kiri -> kanan, atas -> bawah
+SLUGS = [
+    "broken_bottle", "coin_pouch", "coral_cutlass", "crab", "dried_kelp", "driftwood_hatchet", "electric_eel", "firefin_tuna",
+    "jellyfish_jelly", "kraken_cleaver", "kraken_ink", "leviathan_fang", "lobster", "old_boot", "rusty_cutlass", "sailors_hatchet",
+    "salmon", "sardine", "seaweed_clump", "soggy_plank", "storm_bottle", "sunken_chest", "tangled_net", "tidebreaker",
+    "tin_can", "vitality_pearl",
+]
+
+# senjata: slug -> (set animasi yang dipakai, pembesaran dibanding senjata bawaan)
+# Leviathan Fang sengaja pakai animasi Sword: frame BoneSword bawaan nyatu sama efek glow-nya (gak bisa dipisah bersih).
+WEAPONS = {
+    "rusty_cutlass": ("Sword", 1.3),
+    "coral_cutlass": ("Sword", 1.3),
+    "tidebreaker": ("Sword", 1.3),
+    "leviathan_fang": ("Sword", 1.3),
+    "driftwood_hatchet": ("Axe", 1.3),
+    "sailors_hatchet": ("Axe", 1.3),
+    "kraken_cleaver": ("Axe", 1.3),
+}
+
+DIRS = ["up", "down", "left", "right"]
+ICON_SIZE = 64
+SHEET_BG = (35, 44, 56)                      # warna latar sheet
+LABEL_BANDS = [(189, 222), (421, 453), (638, 671), (837, 872)]   # baris teks label (y awal, y akhir)
+
+
+# ----------------------------------------------------------------------------------------------
+# 1. IRIS SHEET -> 26 ITEM TRANSPARAN
+# ----------------------------------------------------------------------------------------------
+def slice_sheet(path):
+    a = np.array(Image.open(path).convert("RGB")).astype(int)
+    bg = np.array(SHEET_BG)
+    d = np.abs(a - bg).sum(2)
+    mask = d > 40
+    for (y0, y1) in LABEL_BANDS:
+        mask[y0:y1, :] = False                       # buang teks label
+    lab, n = ndi.label(ndi.binary_dilation(mask, iterations=5))
+    boxes = []
+    for s in ndi.find_objects(lab):
+        y0, y1, x0, x1 = s[0].start, s[0].stop, s[1].start, s[1].stop
+        if (y1 - y0) >= 40:
+            boxes.append((y0, y1, x0, x1))
+    if len(boxes) != len(SLUGS):
+        raise SystemExit("Ketemu %d item di sheet, harusnya %d. Cek posisi LABEL_BANDS / SHEET_BG." % (len(boxes), len(SLUGS)))
+
+    def row_of(b):
+        cy = (b[0] + b[1]) / 2
+        return 0 if cy < 215 else 1 if cy < 440 else 2 if cy < 660 else 3
+
+    boxes.sort(key=lambda b: (row_of(b), b[2]))
+    out = {}
+    for slug, (y0, y1, x0, x1) in zip(SLUGS, boxes):
+        pad = 3
+        y0, x0 = max(0, y0 - pad), max(0, x0 - pad)
+        y1, x1 = min(a.shape[0], y1 + pad), min(a.shape[1], x1 + pad)
+        crop = a[y0:y1, x0:x1]
+        cd = np.abs(crop - bg).sum(2)
+        # latar = piksel mirip warna latar yang nyambung ke tepi crop (outline gelap item tetap kepake)
+        lb, _ = ndi.label(cd <= 24)
+        border = set(np.unique(np.concatenate([lb[0], lb[-1], lb[:, 0], lb[:, -1]]))) - {0}
+        outside = np.isin(lb, list(border))
+        alpha = np.where(outside, 0.0, 1.0)
+        edge = ndi.binary_dilation(outside, iterations=2) & ~outside
+        alpha = np.where(edge, np.clip((cd - 24) / 80.0, 0, 1), alpha)
+        rgba = np.zeros(crop.shape[:2] + (4,), np.uint8)
+        rgba[..., :3] = np.clip(crop, 0, 255)
+        rgba[..., 3] = (alpha * 255).astype(np.uint8)
+        out[slug] = _trim(_clean_specks(rgba))
+    return out
+
+
+def _clean_specks(rgba, min_frac=0.02):
+    """Buang bintik kecil yang kepisah dari badan item (sisa teks label / noise)."""
+    a = rgba[..., 3] > 40
+    lab, n = ndi.label(ndi.binary_dilation(a, iterations=3))
+    if n <= 1:
+        return rgba
+    sizes = ndi.sum(a, lab, range(1, n + 1))
+    keep = [i + 1 for i, s in enumerate(sizes) if s >= max(30, min_frac * sizes.max())]
+    out = rgba.copy()
+    out[~np.isin(lab, keep), 3] = 0
+    return out
+
+
+def _trim(rgba):
+    ys, xs = np.where(rgba[..., 3] > 20)
+    return rgba[ys.min():ys.max() + 1, xs.min():xs.max() + 1]
+
+
+def _premult_resize(rgba, size):
+    arr = rgba.astype(np.float32)
+    al = arr[..., 3:4] / 255.0
+    pm = np.concatenate([arr[..., :3] * al, arr[..., 3:4]], axis=2)
+    out = np.stack([np.array(Image.fromarray(pm[..., c], "F").resize(size, Image.LANCZOS)) for c in range(4)], axis=2)
+    a = np.clip(out[..., 3:4], 0, 255)
+    rgb = np.where(a > 0.5, out[..., :3] / np.maximum(a / 255.0, 1e-3), 0)
+    return np.clip(np.concatenate([np.clip(rgb, 0, 255), a], axis=2) + 0.5, 0, 255).astype(np.uint8)
+
+
+def make_icon(rgba, size=ICON_SIZE, margin=2):
+    h, w = rgba.shape[:2]
+    s = (size - 2 * margin) / max(h, w)
+    nw, nh = max(1, round(w * s)), max(1, round(h * s))
+    small = _premult_resize(rgba, (nw, nh))
+    canvas = np.zeros((size, size, 4), np.uint8)
+    ox, oy = (size - nw) // 2, (size - nh) // 2
+    canvas[oy:oy + nh, ox:ox + nw] = small
+    al = canvas[..., 3].astype(np.float32)               # tepi dibuat hampir biner, biar tetap tajam kayak pixel art
+    canvas[..., 3] = np.where(al > 200, 255, np.where(al < 60, 0, al)).astype(np.uint8)
+    return Image.fromarray(canvas, "RGBA")
+
+
+# ----------------------------------------------------------------------------------------------
+# 2. SENJATA DI TANGAN
+# ----------------------------------------------------------------------------------------------
+ARC = (244, 249, 248)          # warna efek tebasan di frame bawaan (cuma dipakai efek)
+OUTLINE = (28, 22, 26, 255)
+MAX_SHIFT = 4.0                # senjata boleh digeser sampai segini piksel biar gak kepotong tepi frame
+
+SWORD_TAIL = {(127, 73, 53), (180, 127, 84), (218, 185, 136)}      # gagang / hand guard
+SWORD_TIP = {(167, 181, 167), (124, 137, 137), (220, 220, 203), (255, 255, 255)}   # bilah
+AXE_TAIL = {(69, 37, 56), (138, 79, 87), (213, 132, 100)}          # tangkai
+AXE_TIP = {(138, 195, 217), (79, 142, 180), (199, 231, 231)}       # kepala kapak
+FAMILY = {"Sword": (SWORD_TAIL, SWORD_TIP), "Axe": (AXE_TAIL, AXE_TIP)}
+
+
+def base_frame_name(wtype, state, direction, i):
+    f = i + 1
+    D = {"up": "Back", "down": "Front", "left": "Left", "right": "Right"}[direction]
+    if wtype == "Sword":
+        return {1: "Sword%s (%d)" % (D, f), 2: "Swing%s (%d)" % (D, f), 3: "%sSw (%d)" % (D, f), 4: "%sSw (%d)" % (D, i + 5)}[state]
+    return {1: "%sAxeThrust (%d)" % (D, f), 2: "%sAxeBash (%d)" % (D, f), 3: "%sAxeSwing (%d)" % (D, f), 4: "%sAxeSwing (%d)" % (D, i + 5)}[state]
+
+
+def load_base(wtype, state, direction, i):
+    return Image.open(os.path.join(ASET, base_frame_name(wtype, state, direction, i) + ".png")).convert("RGBA")
+
+
+def split_frame(rgba, wtype):
+    a = np.array(rgba)
+    rgb = a[..., :3].astype(int)
+    op = a[..., 3] > 0
+    eff = op & (rgb[..., 0] == ARC[0]) & (rgb[..., 1] == ARC[1]) & (rgb[..., 2] == ARC[2])
+    wep = op & ~eff
+    tail_set, tip_set = FAMILY[wtype]
+    tail = np.zeros(op.shape, bool)
+    tip = np.zeros(op.shape, bool)
+    for y, x in zip(*np.nonzero(wep)):
+        c = tuple(rgb[y, x])
+        if c in tail_set: tail[y, x] = True
+        elif c in tip_set: tip[y, x] = True
+    return eff, wep, tail, tip
+
+
+def pose_from_pixels(mask, tail=None):
+    """PCA: sumbu diarahkan dari gagang ke ujung. t_lo/t_hi = ujung gagang/ujung senjata sepanjang sumbu."""
+    ys, xs = np.nonzero(mask)
+    pts = np.stack([xs, ys], 1).astype(float) + 0.5
+    m = pts.mean(0)
+    cov = np.cov((pts - m).T) if len(pts) > 2 else np.eye(2)
+    u = np.linalg.eigh(cov)[1][:, 1]
+    tc = None
+    if tail is not None and tail.sum() >= 3:
+        ty, tx = np.nonzero(tail)
+        tc = np.array([tx.mean() + 0.5, ty.mean() + 0.5])
+        rest = mask & ~tail
+        if rest.sum() >= 1:
+            ry, rx = np.nonzero(rest)
+            if np.dot(u, np.array([rx.mean() + 0.5, ry.mean() + 0.5]) - tc) < 0:
+                u = -u
+    elif u[0] < 0 or (abs(u[0]) < 1e-6 and u[1] > 0):
+        u = -u
+    v = np.array([-u[1], u[0]])
+    t = (pts - m) @ u
+    n = (pts - m) @ v
+    t_lo, t_hi = t.min() - 0.5, t.max() + 0.5
+    far = n[t > (t_lo + t_hi) / 2]
+    return dict(m=m, u=u, v=v, t_lo=t_lo, t_hi=t_hi, skew=float(far.mean()) if len(far) else 0.0,
+                t_anchor=None if tc is None else float((tc - m) @ u))
+
+
+def _premult(rgba):
+    a = np.array(rgba).astype(np.float32)
+    return np.concatenate([a[..., :3] * (a[..., 3:4] / 255.0), a[..., 3:4]], 2)
+
+
+def _unpremult(pm):
+    al = np.clip(pm[..., 3:4], 0, 255)
+    rgb = np.where(al > 1, pm[..., :3] / np.maximum(al / 255.0, 1e-3), 0)
+    return np.clip(rgb, 0, 255), al
+
+
+class Icon:
+    """Item baru (beresolusi tinggi). Gagang di kiri-bawah, ujung di kanan-atas."""
+
+    def __init__(self, rgba):
+        self.rgba = Image.fromarray(rgba, "RGBA")
+        self.mask = rgba[..., 3] > 40
+        p = pose_from_pixels(self.mask)
+        if p["u"][0] - p["u"][1] < 0:
+            p["u"], p["v"] = -p["u"], -p["v"]
+            ys, xs = np.nonzero(self.mask)
+            pts = np.stack([xs, ys], 1).astype(float) + 0.5
+            t = (pts - p["m"]) @ p["u"]
+            n = (pts - p["m"]) @ p["v"]
+            p["t_lo"], p["t_hi"] = t.min() - 0.5, t.max() + 0.5
+            p["skew"] = float(n[t > (p["t_lo"] + p["t_hi"]) / 2].mean())
+        self.pose = p
+
+
+def render_weapon(icon, pose, size, flip=False, shift=(0.0, 0.0), pad=0):
+    """Gambar item dengan pose tertentu di kanvas (size + 2*pad) persegi. Return float RGBA premultiplied."""
+    ip = icon.pose
+    s = (pose["t_hi"] - pose["t_lo"]) / (ip["t_hi"] - ip["t_lo"])
+    w0, h0 = icon.rgba.size
+    nw, nh = max(2, round(w0 * s)), max(2, round(h0 * s))
+    pm = _premult(icon.rgba)
+    small = np.stack([np.array(Image.fromarray(pm[..., c], "F").resize((nw, nh), Image.LANCZOS)) for c in range(4)], 2)
+    sx, sy = nw / w0, nh / h0
+    ci = (ip["m"] + ip["u"] * (ip["t_lo"] + ip["t_hi"]) / 2) * np.array([sx, sy])
+    ui = ip["u"] * np.array([sx, sy])
+    ui /= np.linalg.norm(ui)
+    cb = pose["m"] + pose["u"] * (pose["t_lo"] + pose["t_hi"]) / 2 + np.array(shift, float) + pad
+    theta = math.atan2(pose["u"][1], pose["u"][0]) - math.atan2(ui[1], ui[0])
+    c, sn = math.cos(theta), math.sin(theta)
+    Minv = np.array([[c, sn], [-sn, c]])
+    if flip:                                            # cerminkan lewat sumbu senjata (kepala kapak pindah sisi)
+        Minv = (2 * np.outer(ui, ui) - np.eye(2)) @ Minv
+    P = np.array([[0, 1], [1, 0]])                      # scipy pakai (baris, kolom) = (y, x)
+    M_rc = P @ Minv @ P
+    off_rc = P @ (ci - Minv @ cb)
+    S = size + 2 * pad
+    out = np.zeros((S, S, 4), np.float32)
+    for k in range(4):
+        out[..., k] = ndi.affine_transform(small[..., k], M_rc, offset=off_rc, output_shape=(S, S), order=1, mode="constant", cval=0.0)
+    return out
+
+
+def analyze_all(wtype):
+    info = {}
+    for st in (1, 2, 3, 4):
+        for d in DIRS:
+            for i in range(4):
+                fr = load_base(wtype, st, d, i)
+                eff, wep, tail, tip = split_frame(fr, wtype)
+                pose = pose_from_pixels(wep, tail) if wep.sum() >= 4 else None
+                info[(st, d, i)] = dict(frame=fr, eff=eff, wep=wep, pose=pose, ntip=int(tip.sum()))
+    Ls = [v["pose"]["t_hi"] - v["pose"]["t_lo"] for v in info.values() if v["pose"]]
+    L_nom = float(np.percentile(Ls, 80))                # panjang senjata bawaan yang utuh (gak ketutup efek)
+    rs = [(v["pose"]["t_anchor"] - v["pose"]["t_lo"]) / (v["pose"]["t_hi"] - v["pose"]["t_lo"])
+          for v in info.values()
+          if v["pose"] and v["pose"]["t_anchor"] is not None and (v["pose"]["t_hi"] - v["pose"]["t_lo"]) >= 0.93 * L_nom]
+    return info, L_nom, float(np.median(rs))
+
+
+def compose_frame(v, icon, anchor, r_tail, L_nom, grow, allow_flip, flip_hint, alpha_cut=110, margin=2):
+    a = np.array(v["frame"])
+    h, w = a.shape[:2]
+    eff, wep, base = v["eff"], v["wep"], v["pose"]
+    if not allow_flip:
+        flip = False
+    elif flip_hint is not None:
+        flip = flip_hint
+    else:
+        flip = bool(np.sign(icon.pose["skew"]) != np.sign(base["skew"]))
+    PAD = 24
+
+    def pose_for(L):
+        q = dict(base)
+        q["t_lo"] = anchor - r_tail * L                 # gagang tetap di tangan, ujungnya yang memanjang
+        q["t_hi"] = q["t_lo"] + L
+        return q
+
+    def draw(L, shift=(0.0, 0.0)):
+        pm = render_weapon(icon, pose_for(L), h, flip=flip, shift=shift, pad=PAD)
+        rgb, al = _unpremult(pm)
+        return rgb, al[..., 0] >= alpha_cut
+
+    def overflow(m):
+        ys, xs = np.nonzero(m)
+        if not len(xs):
+            return 0.0, 0.0
+        dx = dy = 0.0
+        if xs.min() - PAD < margin: dx = margin - (xs.min() - PAD)
+        if xs.max() - PAD > w - 1 - margin: dx = (w - 1 - margin) - (xs.max() - PAD)
+        if ys.min() - PAD < margin: dy = margin - (ys.min() - PAD)
+        if ys.max() - PAD > h - 1 - margin: dy = (h - 1 - margin) - (ys.max() - PAD)
+        return dx, dy
+
+    L = L_nom * grow
+    while True:                                          # kecilkan dikit-dikit kalau terlalu nembus tepi frame
+        rgb, m = draw(L)
+        sh = overflow(m)
+        if max(abs(sh[0]), abs(sh[1])) <= MAX_SHIFT or L <= L_nom + 1e-6:
+            break
+        L = max(L_nom, L - 0.05 * L_nom)
+    rgb, m = draw(L, sh)
+    rgb, m = rgb[PAD:PAD + h, PAD:PAD + w], m[PAD:PAD + h, PAD:PAD + w]
+
+    out = np.zeros_like(a)
+    out[eff] = a[eff]
+    # tambal efek yang dulu ketutup senjata lama (lubang yang dikelilingi efek)
+    hole = wep & ~m
+    effm = eff.copy()
+    for _ in range(2):
+        nb = ndi.convolve(effm.astype(int), np.ones((3, 3), int), mode="constant") - effm.astype(int)
+        effm = effm | (hole & ~effm & (nb >= 3))
+    out[effm & ~eff] = (ARC[0], ARC[1], ARC[2], 255)
+    ring = ndi.binary_dilation(m, structure=np.ones((3, 3), bool)) & ~m       # outline gelap 1 piksel
+    out[ring] = OUTLINE
+    out[m] = np.concatenate([rgb[m], np.full((int(m.sum()), 1), 255)], 1).astype(np.uint8)
+    return Image.fromarray(out, "RGBA"), flip
+
+
+def build_held_sheet(icon, wtype, grow):
+    allow_flip = (wtype == "Axe")
+    info, L_nom, r_tail = analyze_all(wtype)
+    sheet = Image.new("RGBA", (16 * 64, 4 * 64), (0, 0, 0, 0))
+    for st in (1, 2, 3, 4):
+        for r, d in enumerate(DIRS):
+            last_flip = None
+            for i in range(4):
+                v = info[(st, d, i)]
+                p = v["pose"]
+                if p is None:
+                    frame = v["frame"]
+                else:
+                    anchor = p["t_anchor"] if p["t_anchor"] is not None else p["t_lo"] + r_tail * (p["t_hi"] - p["t_lo"])
+                    hint = last_flip if (v["ntip"] < 20 and last_flip is not None) else None   # kepala kapak gak kelihatan: ikut frame sebelumnya
+                    frame, used = compose_frame(v, icon, anchor, r_tail, L_nom, grow, allow_flip, hint)
+                    if v["ntip"] >= 20:
+                        last_flip = used
+                sheet.paste(frame, (((st - 1) * 4 + i) * 64, r * 64))
+    return sheet
+
+
+# ----------------------------------------------------------------------------------------------
+def main():
+    if len(sys.argv) < 2:
+        raise SystemExit(__doc__)
+    sheet_path = sys.argv[1]
+    rest = sys.argv[2:]
+    what = next((a for a in rest if a in ("icons", "held")), "all")
+    preview_path = next((a for a in rest if a.lower().endswith(".png")), None)
+
+    crops = slice_sheet(sheet_path)
+    os.makedirs(HELD_DIR, exist_ok=True)
+    icons = {}
+    if what in ("all", "icons"):
+        for slug, rgba in crops.items():
+            icons[slug] = make_icon(rgba)
+            icons[slug].save(os.path.join(ICON_DIR, slug + ".png"))
+        print("ikon:", len(icons), "->", ICON_DIR)
+    if what in ("all", "held"):
+        for slug, (wtype, grow) in WEAPONS.items():
+            build_held_sheet(Icon(crops[slug]), wtype, grow).save(os.path.join(HELD_DIR, slug + ".png"), optimize=True)
+            print("  senjata di tangan:", slug, "(%s x%.2f)" % (wtype, grow))
+        print("held ->", HELD_DIR)
+    if preview_path and icons:
+        cols = 9
+        cell = ICON_SIZE * 2 + 8
+        rows = (len(icons) + cols - 1) // cols
+        P = Image.new("RGBA", (cols * cell, rows * cell), (40, 48, 62, 255))
+        for k, ic in enumerate(icons.values()):
+            big = ic.resize((ICON_SIZE * 2, ICON_SIZE * 2), Image.NEAREST)
+            P.paste(big, ((k % cols) * cell + 4, (k // cols) * cell + 4), big)
+        P.save(preview_path)
+        print("pratinjau ->", preview_path)
+
+
+if __name__ == "__main__":
+    main()
