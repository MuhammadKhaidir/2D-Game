+    private void add(String title, Item item, Kind kind, Rarity rarity, int weight, Cond cond, int min, int max, String quip) {
+        entries.add(new Entry(title, item, kind, rarity, weight, cond, min, max, quip));
+    }
+
+    // ===================================================================
+    // PEMBUAT ITEM
+    // ===================================================================
+
+    private Item food(String name, BufferedImage icon, String flavor, int heal, int hpCost, int buffSeconds, Buff... buffs) {
+        Item it = new Item(name, icon);
+        it.onUse = effect(heal, hpCost, buffSeconds, buffs);
+        byName.put(name.toLowerCase(), it);
+        String effect = effectSentence(heal, hpCost, buffSeconds, buffs);
+        descriptions.put(name.toLowerCase(), flavor + (effect.isEmpty() ? "" : " " + effect) + " Put it in the hotbar to eat it.");
+        return it;
+    }
+
+    private Item junk(String name, BufferedImage icon, String flavor) {
+        Item it = new Item(name, icon);
+        byName.put(name.toLowerCase(), it);
+        descriptions.put(name.toLowerCase(), flavor);
+        return it;
+    }
+
+    private Item weapon(String name, BufferedImage icon, String baseType, int rgb, float amount, int damage, String flavor) {
+        Item it = new Item(name, icon);
+        it.maxStack = 1;
+        byName.put(name.toLowerCase(), it);
+        weaponSpecs.put(name.toLowerCase(), new WeaponSpec(baseType, rgb, amount, damage));
+        descriptions.put(name.toLowerCase(), flavor + " Damage +" + damage + ". Right-click in your backpack (or use the hotbar) to equip.");
+        return it;
+    }
+
+    private BufferedImage icon(int body, int belly, int fin, boolean big, boolean sparkle) {
+        return im.createFishIcon(body, belly, fin, big, sparkle);
+    }
+
+    /** Ikon senjata: ambil gambar ikon yang sudah ada lalu diwarnai ulang. Kalau filenya gak ada, ikon kosong (aman). */
+    private BufferedImage tintedIcon(String path, int rgb, float amount) {
+        try (InputStream is = getClass().getResourceAsStream(path)) {
+            if (is != null) {
+                BufferedImage src = ImageIO.read(is);
+                if (src != null) return FishingIcons.tint(src, rgb, amount);
+            }
+        } catch (Exception ignored) { /* jatuh ke ikon bawaan di bawah */ }
+        return FishingIcons.axe();
+    }
+
+    // ===================================================================
+    // EFEK MAKAN
+    // ===================================================================
+
+    /**
+     * Efek makan lewat hotbar. Urutannya: bayar HP (kalau ada) -> aktifin buff -> heal.
+     * Return false (item TIDAK habis) kalau HP sudah penuh dan makanannya cuma heal, atau HP terlalu tipis buat bayar harga.
+     */
+    private Item.UseEffect effect(int heal, int hpCost, int buffSeconds, Buff... buffs) {
+        return gp -> {
+            Entitas.player p = gp.player;
+            if (p == null || p.isDead) return false;
+            if (hpCost > 0 && p.life <= hpCost + 5) {
+                say(gp, "Too risky at this HP.");
+                return false;
+            }
+            boolean hasBuff = buffs != null && buffs.length > 0;
+            if (!hasBuff && hpCost == 0 && p.life >= p.maxLife) {
+                say(gp, "HP is already full.");
+                return false;
+            }
+
+            StringBuilder msg = new StringBuilder();
+            if (hpCost > 0) {
+                p.life -= hpCost;
+                msg.append("-").append(hpCost).append(" HP  ");
+            }
+            if (hasBuff) {
+                for (Buff b : buffs) p.buffs.activate(b, buffSeconds * gp.FPS);
+                msg.append(buffs.length == 1 ? buffs[0].label : "All Combat Boosts").append("!  ");
+            }
+            if (heal > 0 && p.life < p.maxLife) {
+                int before = p.life;
+                p.life = Math.min(p.maxLife, p.life + heal);
+                msg.append("+").append(p.life - before).append(" HP");
+            }
+            say(gp, msg.toString().trim());
+            return true;
+        };
+    }
+
+    private static String effectSentence(int heal, int hpCost, int buffSeconds, Buff... buffs) {
+        List<String> parts = new ArrayList<>();
+        if (heal > 0) parts.add("restores " + heal + " HP");
+        if (buffs != null && buffs.length == 1) {
+            parts.add("grants " + buffs[0].effectText() + " for " + PlayerBuffs.formatTime(buffSeconds));
+        } else if (buffs != null && buffs.length > 1) {
+            parts.add("grants damage, speed and attack speed boosts for " + PlayerBuffs.formatTime(buffSeconds));
+        }
+        String s = String.join(" and ", parts);
+        if (hpCost > 0) s += (s.isEmpty() ? "" : ", but") + " costs " + hpCost + " HP";
+        return s.isEmpty() ? "" : "It " + s + ".";
+    }
+
+    private static void say(GamePanel gp, String msg) {
+        if (gp.speechBubble != null) gp.speechBubble.show(msg);
+    }
