+        String key = item.name.toLowerCase();
+        WeaponSpec spec = weaponSpecs.get(key);
+        if (spec == null) return null;
+        Weapon w = weaponCache.get(key);
+        if (w == null) {
+            w = new Weapon(item.name, spec.type);
+            w.damage = spec.damage;
+            w.tint(spec.rgb, spec.amount);
+            weaponCache.put(key, w);
+        }
+        return w;
+    }
+
+    public boolean isWeapon(Item item) {
+        return item != null && item.name != null && weaponSpecs.containsKey(item.name.toLowerCase());
+    }
+
+    public List<Entry> entries() {
+        return entries;
+    }
+
+    // ===================================================================
+    // ROLL
+    // ===================================================================
+
+    /** Bobot sebuah entry pada kondisi ini (0 = gak mungkin keluar). */
+    public static double effectiveWeight(Entry e, Context c) {
+        return e.weight * e.cond.multiplier(c);
+    }
+
+    /** Pilih satu tangkapan berdasarkan bobot + kondisi. Belum menambahkan apa pun ke backpack. */
+    public Entry roll(Context c) {
+        double total = 0;
+        for (Entry e : entries) total += effectiveWeight(e, c);
+        double r = rng.nextDouble() * total;
+        for (Entry e : entries) {
+            double w = effectiveWeight(e, c);
+            if (w <= 0) continue;
+            r -= w;
+            if (r < 0) return e;
+        }
+        return entries.get(0);
+    }
+
+    // ===================================================================
+    // BERI HADIAH
+    // ===================================================================
+
+    /** Masukin hasil tangkapan ke backpack (termasuk buka peti) dan kembalikan datanya buat ditampilkan. */
+    public Result award(Entry e, GamePanel gp) {
+        List<String> lines = new ArrayList<>();
+        Item icon = e.item;
+
+        switch (e.kind) {
+            case WEAPON:
+                if (im.count(e.item) > 0) {
+                    im.add(im.COIN, DUPLICATE_WEAPON_COINS);
+                    lines.add("Already owned: +" + DUPLICATE_WEAPON_COINS + " Coin");
+                } else {
+                    im.add(e.item, 1);
+                    lines.add("Damage +" + weaponSpecs.get(e.item.name.toLowerCase()).damage);
+                }
+                break;
+
+            case TREASURE:
+                openChest(lines);
+                break;
+
+            default: {
+                int amount = e.min + (e.max > e.min ? rng.nextInt(e.max - e.min + 1) : 0);
+                im.add(e.item, amount);
+                if (amount > 1 || !e.title.equals(e.item.name)) lines.add("+" + amount + " " + e.item.name);
+                break;
+            }
+        }
+        return new Result(e.title, icon, e.rarity, e.kind, lines, e.quip);
+    }
+
+    private void openChest(List<String> lines) {
+        int coins = CHEST_COINS_MIN + rng.nextInt(CHEST_COINS_MAX - CHEST_COINS_MIN + 1);
+        im.add(im.COIN, coins);
+        lines.add("+" + coins + " Coin");
+
+        if (rng.nextDouble() < 0.45) {
+            PotionType[] pool = {PotionType.SMALL_HP, PotionType.SMALL_HP, PotionType.MEDIUM_HP, PotionType.DAMAGE,
+                                 PotionType.SPEED, PotionType.ATTACK_SPEED, PotionType.MAX_HP};
+            PotionType type = pool[rng.nextInt(pool.length)];
+            im.add(im.getPotion(type), 1);
+            lines.add("+1 " + type.itemName);
+        }
+        if (rng.nextDouble() < 0.04) {
+            im.add(TIDAL_PEARL, 1);
+            lines.add("+1 Tidal Pearl");
+        }
+    }
+}
