+    /** {hx, hy, tx, ty, cx, cy} dalam koordinat layar. Tangan, ujung joran, titik kontrol lengkung. */
+    private float[] rodGeometry(int pScreenX, int pScreenY, double[] pose) {
+        int ts = gp.tileSize;
+        float hx = pScreenX + ts / 2f + (fdx != 0 ? fdx * 9 : 9);
+        float hy = pScreenY + ts / 2f + 6;
+        double reach = pose[0], lift = pose[1], bend = pose[2];
+        float tx = hx + (float) (fdx * ROD_LEN * reach);
+        float ty = hy + (float) (fdy * ROD_LEN * reach * 0.8 - ROD_LEN * lift);
+        float cx = (hx + tx) / 2f;
+        float cy = (hy + ty) / 2f + (float) (bend * ROD_LEN * 0.45);
+        return new float[] {hx, hy, tx, ty, cx, cy};
+    }
+
+    /** Posisi dunia hasil tangkapan yang lagi terbang: {x, y, tinggi}. u = 0..1 */
+    private double[] flightWorldPos(double u) {
+        player p = gp.player;
+        double ex = p.x + gp.tileSize / 2.0, ey = p.y + gp.tileSize / 2.0;
+        double e = u * u * (3 - 2 * u) * 0.35 + u * 0.65;       // sedikit ease supaya keluar air cepat
+        double x = lerp(bobberX, ex, e);
+        double y = lerp(bobberY, ey, e);
+        double dist = Math.hypot(ex - bobberX, ey - bobberY);
+        double h = Math.sin(Math.PI * u) * (34 + dist * 0.22) + u * 26;   // busur, berakhir di atas kepala
+        return new double[] {x, y, h};
+    }
