+    /** Pose joran: {reach, lift, bend}. reach: -1 (ke belakang) .. 1 (ke depan), lift: tinggi ujung (0..1), bend: lengkung (0..1). */
+    private double[] rodPose() {
+        double reach = 1, lift = 0.38, bend = 0.05;
+        switch (state) {
+            case CASTING: {
+                int f = frame;
+                if (f < CAST_WINDUP) {                               // tarik ke belakang pelan
+                    double u = smooth(f / (double) CAST_WINDUP);
+                    reach = lerp(0.3, -0.8, u);
+                    lift = lerp(0.2, 1.0, u);
+                    bend = 0.15 * u;
+                } else if (f < CAST_WINDUP + 4) {                    // lecutan ke depan, cepat
+                    double u = (f - CAST_WINDUP) / 4.0;
+                    u = 1 - (1 - u) * (1 - u);
+                    reach = lerp(-0.8, 1.0, u);
+                    lift = lerp(1.0, 0.45, u);
+                    bend = 0.15 + 0.65 * Math.sin(u * Math.PI);
+                } else {                                             // ujung joran masih bergetar
+                    double u = (f - CAST_WINDUP - 4) / (double) (CAST_FRAMES - CAST_WINDUP - 4);
+                    reach = 1.0;
+                    lift = lerp(0.45, 0.38, u);
+                    bend = 0.3 * (1 - u) * Math.cos(u * 9);
+                }
+                break;
+            }
+            case WAITING: {
+                lift = 0.38 + 0.015 * Math.sin(tick * 0.07);
+                bend = 0.06;
+                if (nibbleTimer > 0) bend += 0.28 * Math.sin((14 - nibbleTimer) / 14.0 * Math.PI * 2) * Math.min(1, nibbleTimer / 6.0);
+                break;
+            }
+            case BITE:
+                lift = 0.30;
+                bend = 0.75 + 0.22 * Math.sin(tick * 1.9);
+                break;
+            case REELING:
+                if (reelCatch) {
+                    if (frame < HOOK_FRAMES) {                       // joran dijentak ke atas
+                        double u = smooth(frame / 4.0);
+                        lift = lerp(0.30, 0.95, u);
+                        bend = 0.9 - 0.3 * u + 0.15 * Math.sin(frame * 1.8);
+                    } else {
+                        double u = smooth((frame - HOOK_FRAMES) / (double) FLY_FRAMES);
+                        lift = lerp(0.95, 0.5, u);
+                        bend = lerp(0.6, 0.0, u);
+                    }
+                } else {
