diff --git a/2DGame/src/Item/FishingFx.java b/2DGame/src/Item/FishingFx.java
new file mode 100644
index 0000000..20ffe88
--- /dev/null
+++ b/2DGame/src/Item/FishingFx.java
@@ -0,0 +1,399 @@
+package Item;
+
+import java.awt.AlphaComposite;
+import java.awt.BasicStroke;
+import java.awt.Color;
+import java.awt.Composite;
+import java.awt.Font;
+import java.awt.FontMetrics;
+import java.awt.Graphics2D;
+import java.awt.RenderingHints;
+import java.awt.geom.AffineTransform;
+import java.awt.image.BufferedImage;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Random;
+
+import Item.FishingLoot.Rarity;
+
+/**
+ * Efek visual mancing: percikan air, riak, kilau, kartu hasil tangkapan, dan kilatan layar buat tangkapan langka.
+ * Murni tampilan, gak nyentuh logika game. Dipakai FishingManager.
+ *
+ * Koordinat partikel = koordinat DUNIA (pixel). x,y = posisi di permukaan air, h = tinggi di atas permukaan
+ * (positif = naik ke atas layar). Waktu dihitung per frame update (game jalan 40 FPS).
+ */
+final class FishingFx {
+
+    private static final int DROP = 0, RING = 1, SPARK = 2;
+
+    private static final class P {
+        int kind;
+        double x, y, h, vx, vy, vh, g;
+        int age, life;
+        float size;
+        Color color;
+        double r, growth;
+        boolean dieOnWater;
+    }
+
+    private static final class Card {
+        final String title;
+        final Rarity rarity;
+        final List<String> lines;
+        final BufferedImage icon;
+        final String quip;
+        int age = 0;
+        final int life;
+
+        Card(FishingLoot.Result r) {
+            this.title = r.title;
+            this.rarity = r.rarity;
+            this.lines = r.lines;
+            this.icon = r.icon != null ? r.icon.icon : null;
+            this.quip = r.quip;
+            this.life = (lines.isEmpty() && quip == null) ? 100 : 125;
+        }
+    }
+
+    private static final Font FONT_TITLE  = new Font("Monospaced", Font.BOLD, 13);
+    private static final Font FONT_LINE   = new Font("Monospaced", Font.PLAIN, 11);
+    private static final Font FONT_RARITY = new Font("Monospaced", Font.BOLD, 9);
+    private static final Font FONT_QUIP   = new Font("Monospaced", Font.ITALIC, 11);
+    private static final Font FONT_BANNER = new Font("Monospaced", Font.BOLD, 28);
+
+    private static final int FLASH_FRAMES = 16;
+    private static final int BANNER_FRAMES = 90;
+
+    private final List<P> particles = new ArrayList<>();
+    private final List<Card> cards = new ArrayList<>();
+    private final Random rng = new Random();
+
+    private int flashTimer = 0;
+    private int bannerTimer = 0;
+    private Rarity effectRarity = Rarity.COMMON;
+
+    // ===================================================================
+    // SPAWN
+    // ===================================================================
+
+    /** Percikan air: butiran terlempar ke atas lalu jatuh balik ke air. */
+    void splash(double x, double y, int count, double power) {
+        for (int i = 0; i < count; i++) {
+            P p = new P();
+            p.kind = DROP;
+            double a = rng.nextDouble() * Math.PI * 2;
+            double sp = (0.4 + rng.nextDouble() * 1.1) * power;
+            p.x = x; p.y = y; p.h = 2;
+            p.vx = Math.cos(a) * sp;
+            p.vy = Math.sin(a) * sp * 0.35;
+            p.vh = (2.0 + rng.nextDouble() * 2.6) * power;
+            p.g = 0.28;
+            p.life = 46;
+            p.size = 1.6f + rng.nextFloat() * 1.6f;
+            p.color = rng.nextBoolean() ? new Color(235, 248, 255) : new Color(170, 215, 245);
+            p.dieOnWater = true;
+            particles.add(p);
+        }
+    }
+
+    /** Riak air yang melebar lalu pudar. delay = berapa frame ditahan dulu sebelum muncul. */
+    void ring(double x, double y, double startR, double growth, int life, Color c, int delay) {
+        P p = new P();
+        p.kind = RING;
+        p.x = x; p.y = y;
+        p.r = startR; p.growth = growth;
+        p.life = life;
+        p.age = -delay;
+        p.color = c;
+        particles.add(p);
+    }
+
+    void ring(double x, double y, double startR, double growth, int life) {
+        ring(x, y, startR, growth, life, new Color(235, 245, 255), 0);
+    }
+
+    /** Kilau bintang kecil yang naik pelan (warna kelangkaan). */
+    void sparkles(double x, double y, double h, int count, Color c, double spread) {
+        for (int i = 0; i < count; i++) {
+            P p = new P();
+            p.kind = SPARK;
+            p.x = x + (rng.nextDouble() - 0.5) * spread;
+            p.y = y + (rng.nextDouble() - 0.5) * spread * 0.4;
+            p.h = h + (rng.nextDouble() - 0.5) * spread * 0.5;
+            p.vx = (rng.nextDouble() - 0.5) * 0.4;
+            p.vh = 0.3 + rng.nextDouble() * 0.7;
+            p.life = 22 + rng.nextInt(18);
+            p.size = 2.5f + rng.nextFloat() * 2.5f;
+            p.color = c;
+            particles.add(p);
+        }
+    }
+
+    /** Ledakan kilau ke segala arah (pas hasil tangkapan sampai ke tangan player). */
+    void burst(double x, double y, double h, Color c, int count) {
+        for (int i = 0; i < count; i++) {
+            P p = new P();
+            p.kind = SPARK;
+            double a = rng.nextDouble() * Math.PI * 2;
+            double sp = 0.8 + rng.nextDouble() * 2.2;
+            p.x = x; p.y = y; p.h = h;
+            p.vx = Math.cos(a) * sp;
+            p.vh = Math.sin(a) * sp;
+            p.g = 0.04;
+            p.life = 26 + rng.nextInt(14);
+            p.size = 3f + rng.nextFloat() * 3f;
+            p.color = rng.nextInt(3) == 0 ? Color.WHITE : c;
+            particles.add(p);
+        }
+    }
+
+    /** Butiran air kecil yang netes dari hasil tangkapan yang lagi terbang. */
+    void drip(double x, double y, double h) {
+        P p = new P();
+        p.kind = DROP;
+        p.x = x + (rng.nextDouble() - 0.5) * 6;
+        p.y = y;
+        p.h = h;
+        p.vx = (rng.nextDouble() - 0.5) * 0.4;
+        p.vh = 0.4;
+        p.g = 0.22;
+        p.life = 24;
+        p.size = 1.6f;
+        p.color = new Color(200, 230, 250);
+        particles.add(p);
+    }
+
+    /** Tampilkan kartu hasil tangkapan di atas kepala player. Tangkapan epic / legendary ikut bikin kilatan + banner. */
+    void showCard(FishingLoot.Result r) {
+        cards.add(new Card(r));
+        if (cards.size() > 3) cards.remove(0);
+        if (r.rarity.ordinal() >= Rarity.EPIC.ordinal()) {
+            effectRarity = r.rarity;
+            flashTimer = FLASH_FRAMES;
+            bannerTimer = BANNER_FRAMES;
+        }
+    }
+
+    boolean isEmpty() {
+        return particles.isEmpty() && cards.isEmpty() && flashTimer <= 0 && bannerTimer <= 0;
+    }
+
+    // ===================================================================
+    // UPDATE
+    // ===================================================================
+
+    void update() {
+        for (int i = particles.size() - 1; i >= 0; i--) {
+            P p = particles.get(i);
+            p.age++;
+            if (p.age <= 0) continue;                      // masih ditahan (delay)
+            p.x += p.vx;
+            p.y += p.vy;
+            p.h += p.vh;
+            p.vh -= p.g;
+            p.r += p.growth;
+            if (p.age >= p.life || (p.dieOnWater && p.h < 0)) particles.remove(i);
+        }
+        for (int i = cards.size() - 1; i >= 0; i--) {
+            Card c = cards.get(i);
+            if (++c.age >= c.life) cards.remove(i);
+        }
+        if (flashTimer > 0) flashTimer--;
+        if (bannerTimer > 0) bannerTimer--;
+    }
+
+    // ===================================================================
+    // GAMBAR: partikel (di dunia)
+    // ===================================================================
+
+    /** ox, oy = pergeseran dunia -> layar (player.screenX - player.x, player.screenY - player.y). */
+    void drawParticles(Graphics2D g2, int ox, int oy) {
+        Composite old = g2.getComposite();
+        for (P p : particles) {
+            if (p.age <= 0) continue;
+            float t = p.age / (float) p.life;
+            double sx = p.x + ox;
+            double sy = p.y + oy - p.h;
+            switch (p.kind) {
+                case RING: {
+                    float alpha = Math.max(0f, 0.75f * (1f - t));
+                    g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, alpha));
+                    g2.setColor(p.color);
+                    g2.setStroke(new BasicStroke(1.5f));
+                    int w = (int) Math.round(p.r * 2), h = (int) Math.round(p.r * 0.8);
+                    g2.drawOval((int) Math.round(sx - w / 2.0), (int) Math.round(sy - h / 2.0), w, h);
+                    break;
+                }
+                case SPARK: {
+                    float twinkle = 0.6f + 0.4f * (float) Math.sin(p.age * 0.9 + p.x);
+                    float alpha = Math.max(0f, Math.min(1f, (1f - t) * 1.2f)) * twinkle;
+                    g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, Math.min(1f, alpha)));
+                    g2.setColor(p.color);
+                    int cx = (int) Math.round(sx), cy = (int) Math.round(sy);
+                    int s = Math.round(p.size * (1f - t * 0.5f));
+                    g2.setStroke(new BasicStroke(1.4f));
+                    g2.drawLine(cx - s, cy, cx + s, cy);
+                    g2.drawLine(cx, cy - s, cx, cy + s);
+                    g2.fillRect(cx - 1, cy - 1, 2, 2);
+                    break;
+                }
+                default: {
+                    float alpha = t < 0.6f ? 1f : Math.max(0f, 1f - (t - 0.6f) / 0.4f);
+                    g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, alpha));
+                    g2.setColor(p.color);
+                    int s = Math.max(1, Math.round(p.size));
+                    g2.fillOval((int) Math.round(sx - s / 2.0), (int) Math.round(sy - s / 2.0), s, s);
+                }
+            }
+        }
+        g2.setComposite(old);
+    }
+
+    // ===================================================================
+    // GAMBAR: kartu hasil tangkapan (di atas kepala player)
+    // ===================================================================
+
+    /** anchorX/Y = titik tengah atas kepala player di layar. */
+    void drawCards(Graphics2D g2, int anchorX, int anchorY) {
+        if (cards.isEmpty()) return;
+        Object oldAA = g2.getRenderingHint(RenderingHints.KEY_ANTIALIASING);
+        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+        Composite oldComp = g2.getComposite();
+        AffineTransform oldTx = g2.getTransform();
+
+        int yCursor = anchorY - 46;
+        for (int i = cards.size() - 1; i >= 0; i--) {   // yang terbaru paling bawah
+            Card c = cards.get(i);
+            int h = drawCard(g2, c, anchorX, yCursor);
+            yCursor -= h + 6;
+        }
+
+        g2.setTransform(oldTx);
+        g2.setComposite(oldComp);
+        if (oldAA != null) g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, oldAA);
+    }
+
+    /** @return tinggi kartu yang digambar (buat numpuk kartu berikutnya) */
+    private int drawCard(Graphics2D g2, Card c, int cx, int bottomY) {
+        g2.setFont(FONT_TITLE);
+        FontMetrics fmT = g2.getFontMetrics();
+        g2.setFont(FONT_LINE);
+        FontMetrics fmL = g2.getFontMetrics();
+        g2.setFont(FONT_RARITY);
+        FontMetrics fmR = g2.getFontMetrics();
+        g2.setFont(FONT_QUIP);
+        FontMetrics fmQ = g2.getFontMetrics();
+
+        int textW = Math.max(fmT.stringWidth(c.title), fmR.stringWidth(c.rarity.label.toUpperCase()));
+        for (String l : c.lines) textW = Math.max(textW, fmL.stringWidth(l));
+        if (c.quip != null) textW = Math.max(textW, fmQ.stringWidth(c.quip));
+        int iconBox = 36;
+        int w = 10 + iconBox + 8 + textW + 12;
+        int rows = c.lines.size() + (c.quip != null ? 1 : 0);
+        int h = Math.max(48, 36 + rows * 13 + 6);
+
+        // animasi masuk (membesar sedikit) + keluar (memudar) + naik pelan
+        float pop = c.age < 7 ? 0.7f + 0.3f * (c.age / 7f) : 1f;
+        float fade = c.age > c.life - 20 ? Math.max(0f, (c.life - c.age) / 20f) : 1f;
+        int rise = Math.min(c.age, 24) / 2;
+        int x = cx - w / 2;
+        int y = bottomY - h - rise;
+
+        g2.translate(cx, y + h / 2.0);
+        g2.scale(pop, pop);
+        g2.translate(-cx, -(y + h / 2.0));
+        g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, fade));
+
+        Color rc = c.rarity.color;
+        boolean fancy = c.rarity.ordinal() >= Rarity.RARE.ordinal();
+        if (fancy) {   // cahaya lembut di belakang kartu
+            float glow = 0.20f + 0.10f * (float) Math.sin(c.age * 0.25);
+            g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, fade * glow * (c.rarity.ordinal() - 1)));
+            g2.setColor(rc);
+            g2.fillRoundRect(x - 6, y - 6, w + 12, h + 12, 20, 20);
+            g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, fade));
+        }
+
+        g2.setColor(new Color(24, 18, 12, 232));
+        g2.fillRoundRect(x, y, w, h, 12, 12);
+        g2.setColor(rc);
+        g2.setStroke(new BasicStroke(2f));
+        g2.drawRoundRect(x, y, w, h, 12, 12);
+
+        // kotak ikon
+        int ix = x + 8, iy = y + 6;
+        g2.setColor(new Color(0, 0, 0, 110));
+        g2.fillRoundRect(ix, iy, iconBox, iconBox, 8, 8);
+        g2.setColor(new Color(rc.getRed(), rc.getGreen(), rc.getBlue(), 120));
+        g2.setStroke(new BasicStroke(1f));
+        g2.drawRoundRect(ix, iy, iconBox, iconBox, 8, 8);
+        if (c.icon != null) g2.drawImage(c.icon, ix + 3, iy + 3, iconBox - 6, iconBox - 6, null);
+
+        // teks
+        int tx = ix + iconBox + 8;
+        g2.setFont(FONT_TITLE);
+        g2.setColor(rc);
+        g2.drawString(c.title, tx, y + 20);
+        g2.setFont(FONT_RARITY);
+        g2.setColor(new Color(rc.getRed(), rc.getGreen(), rc.getBlue(), 170));
+        g2.drawString(c.rarity.label.toUpperCase(), tx, y + 32);
+        g2.setFont(FONT_LINE);
+        g2.setColor(new Color(235, 225, 205));
+        int ly = y + 47;
+        for (String l : c.lines) {
+            g2.drawString(l, tx, ly);
+            ly += 13;
+        }
+        if (c.quip != null) {                       // komentar player, lebih redup & miring
+            g2.setFont(FONT_QUIP);
+            g2.setColor(new Color(180, 168, 146));
+            g2.drawString(c.quip, tx, ly);
+        }
+        return h;
+    }
+
+    // ===================================================================
+    // GAMBAR: efek layar penuh (epic / legendary)
+    // ===================================================================
+
+    void drawOverlay(Graphics2D g2, int w, int h) {
+        if (flashTimer <= 0 && bannerTimer <= 0) return;
+        Object oldAA = g2.getRenderingHint(RenderingHints.KEY_ANTIALIASING);
+        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+        Composite old = g2.getComposite();
+        Color rc = effectRarity.color;
+
+        if (flashTimer > 0) {
+            float a = 0.36f * flashTimer / FLASH_FRAMES;
+            g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, a));
+            g2.setColor(new Color(Math.min(255, rc.getRed() + 110), Math.min(255, rc.getGreen() + 110), Math.min(255, rc.getBlue() + 110)));
+            g2.fillRect(0, 0, w, h);
+        }
+
+        if (bannerTimer > 0) {
+            int age = BANNER_FRAMES - bannerTimer;
+            float fade = bannerTimer < 20 ? bannerTimer / 20f : 1f;
+            float slide = Math.min(1f, age / 8f);
+            String text = effectRarity.label.toUpperCase() + " CATCH!";
+            g2.setFont(FONT_BANNER);
+            FontMetrics fm = g2.getFontMetrics();
+            int tw = fm.stringWidth(text);
+            int y = (int) (h * 0.20f) - (int) ((1f - slide) * 24);
+
+            g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, fade * 0.55f));
+            g2.setColor(new Color(0, 0, 0));
+            g2.fillRoundRect(w / 2 - tw / 2 - 26, y - 34, tw + 52, 50, 16, 16);
+            g2.setComposite(AlphaComposite.getInstance(AlphaComposite.SRC_OVER, fade));
+            g2.setColor(new Color(0, 0, 0, 200));
+            g2.drawString(text, w / 2 - tw / 2 + 2, y + 2);
+            g2.setColor(rc);
+            g2.drawString(text, w / 2 - tw / 2, y);
+            g2.setStroke(new BasicStroke(2f));
+            g2.drawLine(w / 2 - tw / 2, y + 8, w / 2 + tw / 2, y + 8);
+        }
+
+        g2.setComposite(old);
+        if (oldAA != null) g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, oldAA);
+    }
+}
diff --git a/2DGame/src/Item/FishingIcons.java b/2DGame/src/Item/FishingIcons.java
new file mode 100644
index 0000000..8853718
--- /dev/null
+++ b/2DGame/src/Item/FishingIcons.java
@@ -0,0 +1,283 @@
+package Item;
+
+import java.awt.Color;
+import java.awt.Graphics2D;
+import java.awt.RenderingHints;
+import java.awt.image.BufferedImage;
+
+/**
+ * Ikon item hasil mancing, semuanya digambar lewat kode (16x16 piksel, di-scale 4x nearest jadi 64x64),
+ * jadi gak butuh file gambar. Mau pakai gambar sendiri? Ganti icon-nya di {@link FishingLoot}.
+ *
+ * Isinya juga {@link #tint}: mewarnai ulang sprite (dipakai senjata hasil mancing biar beda tampilan
+ * dari Sword / Axe / Bone Sword aslinya, tanpa perlu sprite baru).
+ */
+public final class FishingIcons {
+
+    private FishingIcons() {}
+
+    // ===================================================================
+    // HELPER
+    // ===================================================================
+
+    private static BufferedImage canvas() {
+        return new BufferedImage(16, 16, BufferedImage.TYPE_INT_ARGB);
+    }
+
+    private static Graphics2D gfx(BufferedImage img) {
+        Graphics2D g = img.createGraphics();
+        g.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_OFF);
+        return g;
+    }
+
+    private static void px(BufferedImage img, int x, int y, int argb) {
+        if (x >= 0 && y >= 0 && x < img.getWidth() && y < img.getHeight()) img.setRGB(x, y, argb);
+    }
+
+    /** Scale 4x tanpa blur (nearest) -> 64x64, sama kayak ikon potion / ikan. */
+    public static BufferedImage scaleUp(BufferedImage small) {
+        BufferedImage big = new BufferedImage(64, 64, BufferedImage.TYPE_INT_ARGB);
+        Graphics2D g = big.createGraphics();
+        g.setRenderingHint(RenderingHints.KEY_INTERPOLATION, RenderingHints.VALUE_INTERPOLATION_NEAREST_NEIGHBOR);
+        g.drawImage(small, 0, 0, 64, 64, null);
+        g.dispose();
+        return big;
+    }
+
+    /**
+     * Warnai ulang gambar ke arah warna rgb tapi bayangan / highlight aslinya tetap kebawa (alpha tidak berubah).
+     * @param amount 0 = gambar asli, 1 = warna penuh
+     */
+    public static BufferedImage tint(BufferedImage src, int rgb, float amount) {
+        if (src == null) return null;
+        int tr = (rgb >> 16) & 0xFF, tg = (rgb >> 8) & 0xFF, tb = rgb & 0xFF;
+        BufferedImage out = new BufferedImage(src.getWidth(), src.getHeight(), BufferedImage.TYPE_INT_ARGB);
+        for (int y = 0; y < src.getHeight(); y++) {
+            for (int x = 0; x < src.getWidth(); x++) {
+                int argb = src.getRGB(x, y);
+                int a = (argb >>> 24) & 0xFF;
+                if (a == 0) continue;
+                int r = (argb >> 16) & 0xFF, g = (argb >> 8) & 0xFF, b = argb & 0xFF;
+                float lum = (0.299f * r + 0.587f * g + 0.114f * b) / 150f;   // 1.0 = terang sedang
+                int nr = Math.min(255, Math.round(tr * lum));
+                int ng = Math.min(255, Math.round(tg * lum));
+                int nb = Math.min(255, Math.round(tb * lum));
+                r = Math.round(r + (nr - r) * amount);
+                g = Math.round(g + (ng - g) * amount);
+                b = Math.round(b + (nb - b) * amount);
+                out.setRGB(x, y, (a << 24) | (r << 16) | (g << 8) | b);
+            }
+        }
+        return out;
+    }
+
+    // ===================================================================
+    // IKON
+    // ===================================================================
+
+    public static BufferedImage crab() {
+        BufferedImage s = canvas();
+        Graphics2D g = gfx(s);
+        Color shell = new Color(0xD9442E), dark = new Color(0x6E1B12), light = new Color(0xF58A6E);
+        // kaki
+        g.setColor(dark);
+        g.drawLine(3, 10, 1, 12); g.drawLine(4, 11, 3, 14);
+        g.drawLine(12, 10, 14, 12); g.drawLine(11, 11, 12, 14);
+        g.drawLine(6, 12, 6, 14); g.drawLine(9, 12, 9, 14);
+        // lengan
+        g.drawLine(4, 8, 3, 6); g.drawLine(11, 8, 12, 6);
+        // capit
+        g.setColor(shell);
+        g.fillOval(0, 2, 5, 5); g.fillOval(11, 2, 5, 5);
+        g.setColor(dark);
+        g.drawOval(0, 2, 4, 4); g.drawOval(11, 2, 4, 4);
+        g.drawLine(2, 2, 2, 3); g.drawLine(13, 2, 13, 3);           // celah capit
+        // badan
+        g.setColor(shell);
+        g.fillOval(3, 6, 10, 7);
+        g.setColor(light);
+        g.fillRect(6, 7, 4, 1);
+        g.setColor(dark);
+        g.drawOval(3, 6, 9, 6);
+        // mata
