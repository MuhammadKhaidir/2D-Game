+        // tiang kiri & kanan
+        int[] col = {STONE_L, STONE_L, STONE_M, STONE_M, STONE_M, STONE_D, STONE_D, STONE_DD, STONE_DD, STONE_DD};
+        for (int y = 14; y < 58; y++) {
