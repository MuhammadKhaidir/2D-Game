+    static final int[][] CORAL_PAL = {
+        {0xFF8FB1, 0xFFC0D4, 0xC8527C},   // merah muda
+        {0xFFA24D, 0xFFCB8C, 0xC4671F},   // jingga
+        {0xA070E8, 0xCDAEFF, 0x6B3FB0},   // ungu
