+        if (flower) { c.set(7, 4, 0xFFFFFF); c.set(6, 4, 0xF6A6C8); c.set(8, 4, 0xF6A6C8); c.set(7, 3, 0xF6A6C8); c.set(7, 5, 0xF6A6C8); }
